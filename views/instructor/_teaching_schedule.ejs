<!-- Faculty Teaching Load — multiple instructors -->
<% const schedules = teachingSchedules || []; const semesterLabel = teachingSemesterLabel || 'SY 2026-2027 1st Semester (PATHFIT 1 & 3 FACULTY TEACHING LOAD)'; %>
<% const defaultTimeSlots = teachingTimeSlots || []; %>
<% const schedulesAllLocked = schedules.length > 0 && schedules.every(function (s) { return s.is_locked; }); %>

<div class="card teaching-schedule-card" id="teachingScheduleCard">
  <div class="schedule-toolbar">
    <div>
      <h3 style="margin:0;border:none;padding:0;">Faculty Teaching Load</h3>
      <p class="schedule-toolbar-sub">Edit semester, times in each grid, instructor names, and class codes. Lock each instructor when finished.</p>
    </div>
    <div class="schedule-toolbar-actions">
      <span class="schedule-count-badge"><%= schedules.length %> instructor<%= schedules.length === 1 ? '' : 's' %></span>
    </div>
  </div>

  <% if (scheduleSuccess) { %>
    <div class="alert alert-success"><%= scheduleSuccess %></div>
  <% } %>
  <% if (scheduleError) { %>
    <div class="alert alert-error"><%= scheduleError %></div>
  <% } %>

  <div class="schedule-sheet schedule-sheet-master">
    <div class="schedule-semester-bar">
      <input type="text" id="globalSemesterLabel" class="schedule-semester-input"
             value="<%= semesterLabel %>"
             placeholder="SY 2026-2027 1st Semester (PATHFIT 1 & 3 FACULTY TEACHING LOAD)"
             aria-label="Semester label"
             <%= schedulesAllLocked ? 'readonly' : '' %>>
    </div>
  </div>

  <% if (!schedules.length) { %>
    <div class="schedule-empty-state">
      <p>No instructor schedules yet. Add the first one below.</p>
    </div>
  <% } %>

  <div id="scheduleBlocksList">
    <% schedules.forEach(function(sched, blockIdx) {
      const locked = !!sched.is_locked;
      const blockId = sched.schedule_id;
      const blockTimeSlots = sched.time_slots || defaultTimeSlots;
    %>
    <div class="schedule-block-wrap" data-block-index="<%= blockIdx %>">
      <form method="POST" action="/instructor/schedule/save" class="schedule-block-form" id="scheduleForm-<%= blockId %>">
        <input type="hidden" name="schedule_id" value="<%= blockId %>">
        <input type="hidden" name="schedule_data" class="schedule-data-input" value="">
        <input type="hidden" name="time_slots" class="schedule-times-input" value="">
        <input type="hidden" name="semester_label" class="schedule-semester-hidden" value="<%= semesterLabel %>">

        <div class="schedule-block-toolbar">
          <span class="schedule-lock-badge <%= locked ? 'locked' : 'unlocked' %>">
            <%= locked ? '🔒 Locked' : '🔓 Editable' %>
          </span>
          <div class="schedule-block-actions">
            <button type="submit" class="btn btn-sm" <%= locked ? 'disabled' : '' %>>Save</button>
            <button type="button" class="btn btn-sm btn-outline schedule-lock-btn"
                    data-schedule-id="<%= blockId %>" data-lock="<%= locked ? 'false' : 'true' %>">
              <%= locked ? 'Unlock' : 'Lock' %>
            </button>
            <% if (!locked) { %>
            <button type="button" class="btn btn-sm btn-danger schedule-delete-btn"
                    data-schedule-id="<%= blockId %>"
                    data-name="<%= (sched.display_name || '').replace(/"/g, '&quot;') %>">Remove</button>
            <% } %>
          </div>
        </div>

        <div class="schedule-sheet schedule-block-sheet <%= locked ? 'is-locked' : '' %>">
          <div class="schedule-instructor-bar">
            <input type="text" name="display_name" class="schedule-instructor-name-input"
                   value="<%= sched.display_name || '' %>"
                   placeholder="LAST NAME, FIRST NAME M.I."
                   maxlength="150"
                   aria-label="Instructor name"
                   <%= locked ? 'readonly' : '' %>>
          </div>

          <div class="schedule-layout">
            <div class="schedule-grid-wrap table-wrap">
              <table class="schedule-grid">
                <thead>
                  <tr>
                    <th class="schedule-time-col">Time</th>
                    <th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th>
                  </tr>
                </thead>
                <tbody class="schedule-grid-body">
                  <% blockTimeSlots.forEach(function(slot) { %>
                  <tr class="schedule-grid-row <%= slot.lunch ? 'schedule-lunch-row' : '' %>" data-slot-id="<%= slot.id %>">
                    <td class="schedule-time-col">
                      <% if (locked) { %>
                        <span class="schedule-time-display"><%= slot.label %></span>
                      <% } else { %>
                        <div class="schedule-time-cell-edit">
                          <input type="text" class="schedule-time-label-input" value="<%= slot.label %>"
                                 placeholder="e.g. 7:00-9:00" maxlength="40" aria-label="Time label">
                          <label class="schedule-lunch-toggle-label schedule-lunch-inline" title="Lunch break row">
                            <input type="checkbox" class="schedule-lunch-toggle" <%= slot.lunch ? 'checked' : '' %>>
                            <span>Lunch</span>
                          </label>
                          <button type="button" class="schedule-time-remove-btn" title="Remove this time row" aria-label="Remove time row">×</button>
                        </div>
                      <% } %>
                    </td>
                    <% if (slot.lunch) { %>
                      <td colspan="5" class="schedule-lunch-cell">LUNCH BREAK</td>
                    <% } else { %>
                      <% teachingDays.forEach(function(day) {
                        const val = (sched.schedule_data && sched.schedule_data[slot.id] && sched.schedule_data[slot.id][day]) || '';
                      %>
                      <td class="schedule-slot-cell">
                        <input type="text"
                               class="schedule-slot-input <%= val ? 'filled' : '' %>"
                               data-slot="<%= slot.id %>"
                               data-day="<%= day %>"
                               value="<%= val %>"
                               placeholder="—"
                               maxlength="40"
                               autocomplete="off"
                               <%= locked ? 'readonly tabindex="-1"' : '' %>>
                      </td>
                      <% }) %>
                    <% } %>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <div class="schedule-units-panel">
              <div class="schedule-units-header">Load Summary</div>
              <label class="schedule-unit-field">
                <span>Deload Units</span>
                <textarea name="deload_units" rows="2" placeholder="e.g. 3 units-Ethics" <%= locked ? 'readonly' : '' %>><%= sched.deload_units || '' %></textarea>
              </label>
              <label class="schedule-unit-field">
                <span>Regular Load</span>
                <textarea name="regular_load" rows="2" placeholder="e.g. 12 units-PATHFit" <%= locked ? 'readonly' : '' %>><%= sched.regular_load || '' %></textarea>
              </label>
              <label class="schedule-unit-field">
                <span>Overload</span>
                <textarea name="overload" rows="2" placeholder="e.g. 9 units-Head, PATHFit/SDO" <%= locked ? 'readonly' : '' %>><%= sched.overload || '' %></textarea>
              </label>
              <label class="schedule-unit-field schedule-unit-total">
                <span>Total Units</span>
                <input type="text" name="total_units" value="<%= sched.total_units || '' %>" placeholder="e.g. 21" maxlength="10" <%= locked ? 'readonly' : '' %>>
              </label>
            </div>
          </div>

          <% if (!locked) { %>
          <div class="schedule-grid-time-actions">
            <button type="button" class="btn btn-sm btn-outline schedule-add-time-btn">+ Add time row</button>
          </div>
          <% } %>

          <% if (locked) { %>
            <div class="schedule-locked-overlay-hint">Locked — unlock to edit this instructor's schedule.</div>
          <% } %>
        </div>
      </form>
    </div>
    <% }) %>
  </div>

  <div class="schedule-add-section">
    <h4 class="schedule-add-title">Add instructor schedule</h4>
    <form method="POST" action="/instructor/schedule/add" class="schedule-add-form" id="scheduleAddForm">
      <input type="hidden" name="semester_label" id="addSemesterHidden" value="<%= semesterLabel %>">
      <input type="hidden" name="time_slots" id="addTimeSlotsHidden" value="">
      <div class="schedule-add-row">
        <label class="schedule-add-label">
          <span>Instructor name</span>
          <input type="text" name="display_name" class="schedule-add-name-input"
                 placeholder="e.g. CULAJARA, EDILYN A." maxlength="150" required>
        </label>
        <button type="submit" class="btn">+ Add Instructor</button>
      </div>
    </form>
  </div>
</div>

<!-- Hidden forms for lock / delete -->
<form method="POST" action="/instructor/schedule/toggle-lock" id="scheduleLockSubmitForm" style="display:none;">
  <input type="hidden" name="schedule_id" id="lockScheduleId">
  <input type="hidden" name="lock" id="lockScheduleValue">
</form>
<form method="POST" action="/instructor/schedule/delete" id="scheduleDeleteSubmitForm" style="display:none;">
  <input type="hidden" name="schedule_id" id="deleteScheduleId">
</form>

<script>
(function () {
  const TEACHING_DAYS = <%- JSON.stringify(teachingDays) %>;
  const DEFAULT_TIME_SLOTS = <%- JSON.stringify(defaultTimeSlots) %>;
  const globalSemester = document.getElementById('globalSemesterLabel');
  const addSemesterHidden = document.getElementById('addSemesterHidden');
  const addTimeSlotsHidden = document.getElementById('addTimeSlotsHidden');
  const lockForm = document.getElementById('scheduleLockSubmitForm');
  const deleteForm = document.getElementById('scheduleDeleteSubmitForm');

  function syncSemesterToForms() {
    const val = globalSemester ? globalSemester.value.trim() : '';
    if (addSemesterHidden) addSemesterHidden.value = val;
    document.querySelectorAll('.schedule-semester-hidden').forEach(function (el) {
      el.value = val;
    });
  }

  function escapeHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
  }

  function collectTimeSlotsFromForm(form) {
    const slots = [];
    const tbody = form.querySelector('.schedule-grid-body');
    if (!tbody) return slots;
    tbody.querySelectorAll('.schedule-grid-row').forEach(function (row, idx) {
      const labelInput = row.querySelector('.schedule-time-label-input');
      const lunchToggle = row.querySelector('.schedule-lunch-toggle');
      const display = row.querySelector('.schedule-time-display');
      const label = labelInput
        ? (labelInput.value || '').trim()
        : (display ? display.textContent.trim() : '');
      if (!label) return;
      let id = row.dataset.slotId;
      if (!id) id = 'slot-' + idx + '-' + Date.now();
      slots.push({ id, label, lunch: !!(lunchToggle && lunchToggle.checked) });
    });
    return slots;
  }

  function syncTimeSlotsHidden(form) {
    const hidden = form.querySelector('.schedule-times-input');
    if (hidden) hidden.value = JSON.stringify(collectTimeSlotsFromForm(form));
  }

  function getCellsFromRow(gridRow) {
    const cells = {};
    gridRow.querySelectorAll('.schedule-slot-input').forEach(function (input) {
      const slotId = input.dataset.slot;
      const day = input.dataset.day;
      if (!cells[slotId]) cells[slotId] = {};
      cells[slotId][day] = input.value.trim();
    });
    return cells;
  }

  function buildTimeCellHtml(slot, locked) {
    if (locked) {
      return '<span class="schedule-time-display">' + escapeHtml(slot.label || '') + '</span>';
    }
    return '<div class="schedule-time-cell-edit">' +
      '<input type="text" class="schedule-time-label-input" value="' + escapeHtml(slot.label || '') + '" placeholder="e.g. 7:00-9:00" maxlength="40" aria-label="Time label">' +
      '<label class="schedule-lunch-toggle-label schedule-lunch-inline" title="Lunch break row">' +
      '<input type="checkbox" class="schedule-lunch-toggle"' + (slot.lunch ? ' checked' : '') + '><span>Lunch</span></label>' +
      '<button type="button" class="schedule-time-remove-btn" title="Remove this time row" aria-label="Remove time row">×</button>' +
      '</div>';
  }

  function buildGridRowHtml(slot, cells, locked) {
    const timeCell = buildTimeCellHtml(slot, locked);
    if (slot.lunch) {
      return '<tr class="schedule-grid-row schedule-lunch-row" data-slot-id="' + slot.id + '">' +
        '<td class="schedule-time-col">' + timeCell + '</td>' +
        '<td colspan="5" class="schedule-lunch-cell">LUNCH BREAK</td></tr>';
    }
    let dayCells = '';
    TEACHING_DAYS.forEach(function (day) {
      const val = (cells && cells[slot.id] && cells[slot.id][day]) || '';
      const filled = val ? ' filled' : '';
      const ro = locked ? ' readonly tabindex="-1"' : '';
      dayCells += '<td class="schedule-slot-cell"><input type="text" class="schedule-slot-input' + filled + '" data-slot="' + slot.id + '" data-day="' + day + '" value="' + escapeHtml(val) + '" placeholder="—" maxlength="40" autocomplete="off"' + ro + '></td>';
    });
    return '<tr class="schedule-grid-row" data-slot-id="' + slot.id + '">' +
      '<td class="schedule-time-col">' + timeCell + '</td>' + dayCells + '</tr>';
  }

  function rebuildGrid(form) {
    const tbody = form.querySelector('.schedule-grid-body');
    if (!tbody) return;
    const locked = form.querySelector('.schedule-block-sheet.is-locked') !== null;
    const timeSlots = collectTimeSlotsFromForm(form);
    const existingCells = {};
    tbody.querySelectorAll('.schedule-grid-row').forEach(function (row) {
      existingCells[row.dataset.slotId] = getCellsFromRow(row);
    });
    const mergedCells = {};
    timeSlots.forEach(function (slot) {
      if (slot.lunch) return;
      mergedCells[slot.id] = existingCells[slot.id] || {};
      TEACHING_DAYS.forEach(function (day) {
        if (mergedCells[slot.id][day] === undefined) mergedCells[slot.id][day] = '';
      });
    });
    tbody.innerHTML = timeSlots.map(function (slot) {
      return buildGridRowHtml(slot, mergedCells, locked);
    }).join('');
    refreshSlotFilledStates(form);
    syncTimeSlotsHidden(form);
  }

  function refreshSlotFilledStates(form) {
    form.querySelectorAll('.schedule-slot-input').forEach(function (input) {
      input.classList.toggle('filled', !!input.value.trim());
    });
  }

  function bindGridEvents(form) {
    if (form.dataset.gridBound === '1') {
      refreshSlotFilledStates(form);
      return;
    }
    form.dataset.gridBound = '1';

    form.addEventListener('input', function (e) {
      if (e.target.classList.contains('schedule-time-label-input')) syncTimeSlotsHidden(form);
      if (e.target.classList.contains('schedule-slot-input')) {
        e.target.classList.toggle('filled', !!e.target.value.trim());
      }
    });

    form.addEventListener('change', function (e) {
      if (e.target.classList.contains('schedule-lunch-toggle')) rebuildGrid(form);
    });

    form.addEventListener('click', function (e) {
      if (e.target.classList.contains('schedule-time-remove-btn')) {
        const tbody = form.querySelector('.schedule-grid-body');
        if (!tbody || tbody.querySelectorAll('.schedule-grid-row').length <= 1) {
          alert('At least one time row is required.');
          return;
        }
        e.target.closest('.schedule-grid-row')?.remove();
        rebuildGrid(form);
        return;
      }
      if (e.target.classList.contains('schedule-add-time-btn')) {
        const tbody = form.querySelector('.schedule-grid-body');
        if (!tbody) return;
        const newId = 'slot-' + Date.now();
        tbody.insertAdjacentHTML('beforeend', buildGridRowHtml({ id: newId, label: '', lunch: false }, {}, false));
        syncTimeSlotsHidden(form);
        tbody.querySelector('.schedule-grid-row:last-child .schedule-time-label-input')?.focus();
      }
    });

    refreshSlotFilledStates(form);
  }

  function collectBlockData(form) {
    const slots = {};
    form.querySelectorAll('.schedule-slot-input').forEach(function (input) {
      const slotId = input.dataset.slot;
      const day = input.dataset.day;
      if (!slots[slotId]) slots[slotId] = {};
      slots[slotId][day] = input.value.trim();
    });
    return slots;
  }

  if (globalSemester) {
    globalSemester.addEventListener('input', syncSemesterToForms);
    syncSemesterToForms();
  }

  if (addTimeSlotsHidden) {
    addTimeSlotsHidden.value = JSON.stringify(DEFAULT_TIME_SLOTS);
  }

  document.querySelectorAll('.schedule-block-form').forEach(function (form) {
    syncTimeSlotsHidden(form);
    bindGridEvents(form);
    form.addEventListener('submit', function () {
      syncSemesterToForms();
      syncTimeSlotsHidden(form);
      const dataInput = form.querySelector('.schedule-data-input');
      if (dataInput) dataInput.value = JSON.stringify(collectBlockData(form));
    });
  });

  document.querySelectorAll('.schedule-lock-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const willLock = btn.dataset.lock === 'true';
      const name = btn.closest('.schedule-block-wrap')
        ?.querySelector('.schedule-instructor-name-input')?.value || 'this instructor';
      if (willLock) {
        if (!confirm('Lock schedule for ' + name + '? Editing will be disabled until unlocked.')) return;
      } else {
        if (!confirm('Unlock schedule for ' + name + '?')) return;
      }
      document.getElementById('lockScheduleId').value = btn.dataset.scheduleId;
      document.getElementById('lockScheduleValue').value = willLock ? 'true' : 'false';
      lockForm.submit();
    });
  });

  document.querySelectorAll('.schedule-delete-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const name = btn.dataset.name || 'this instructor';
      if (!confirm('Remove the schedule for ' + name + '? This cannot be undone.')) return;
      document.getElementById('deleteScheduleId').value = btn.dataset.scheduleId;
      deleteForm.submit();
    });
  });

  const addForm = document.getElementById('scheduleAddForm');
  if (addForm) {
    addForm.addEventListener('submit', function () {
      syncSemesterToForms();
      if (addTimeSlotsHidden && !addTimeSlotsHidden.value) {
        addTimeSlotsHidden.value = JSON.stringify(DEFAULT_TIME_SLOTS);
      }
    });
  }
})();
</script>
