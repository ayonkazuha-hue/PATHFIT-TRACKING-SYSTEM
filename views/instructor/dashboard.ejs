<%- include('../partials/header', { title: 'Instructor Dashboard' }) %>
<div class="container">
  <style>
    .rating-chart-card { margin-bottom: 18px; }
    .rating-chart-sub { color: #042C53; font-size: .9rem; margin: 2px 0 0; line-height: 1.45; }
    .rating-chart-head { display:flex; justify-content:space-between; align-items:flex-end; gap:10px; flex-wrap:wrap; margin-bottom:12px; }
    .rating-chart-filter { display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap; }
    .rating-chart-filter label { display:block; font-size:.8rem; font-weight:700; color:#042C53; margin-bottom:4px; }
    .rating-chart-filter select { min-width:120px; }
    .rating-bars { display:flex; flex-direction:column; gap:10px; }
    .rating-row { display:grid; grid-template-columns: 150px 1fr 96px; align-items:center; gap:10px; }
    .rating-meta { font-size:.82rem; color:#555; text-align:right; font-weight:700; }
    .rating-track { width:100%; height:24px; background:#eef3fb; border-radius:999px; overflow:hidden; border:1px solid #dde6f3; }
    .rating-fill { height:100%; min-width:2px; display:flex; align-items:center; justify-content:flex-end; padding-right:8px; color:#fff; font-size:.72rem; font-weight:700; white-space:nowrap; transition:width .25s ease; }
    .rating-fill.excellent { background:#2e7d32; }
    .rating-fill.very_good { background:#00897b; }
    .rating-fill.good { background:#1565c0; }
    .rating-fill.fair { background:#ef6c00; }
    .rating-fill.needs_improvement { background:#c62828; }
    .rating-fill.poor { background:#4b5563; }
    .student-list-toolbar { display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:14px; padding-bottom:10px; border-bottom:1px solid #e8ecf0; }
    .student-list-actions { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
    .student-filter-bar { margin-bottom:14px; }
    .student-row-actions { display:flex; flex-wrap:wrap; gap:6px; }
    .btn-archive { padding:5px 12px; background:#6b7280; color:#fff; border:none; border-radius:5px; font-size:.78rem; font-weight:700; cursor:pointer; }
    .btn-archive:hover { background:#4b5563; }
    .btn-restore { padding:5px 12px; background:#2e7d32; color:#fff; border:none; border-radius:5px; font-size:.78rem; font-weight:700; cursor:pointer; }
    .btn-restore:hover { background:#1b5e20; }
    .section-archive-panel {
      margin-bottom: 16px; padding: 14px 16px; background: #f5f8fc;
      border: 1.5px solid #e0e8f0; border-radius: 10px;
    }
    .section-archive-panel h4 { margin: 0 0 4px; font-size: .95rem; color: #042C53; border: none; padding: 0; }
    .section-archive-panel p { margin: 0 0 12px; font-size: .82rem; color: #666; }
    .section-archive-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px;
    }
    .section-archive-card {
      display: flex; flex-direction: column; gap: 8px; align-items: stretch;
      padding: 12px; background: #fff; border: 1px solid #e0e8f0; border-radius: 8px;
    }
    .section-archive-code { font-size: .88rem; font-weight: 800; color: #042C53; }
    .section-archive-count { font-size: .78rem; color: #666; }
    .section-archive-card .btn-archive,
    .section-archive-card .btn-restore { width: 100%; padding: 8px 10px; font-size: .78rem; border-radius: 6px; }
    @media (max-width: 768px) {
      .section-archive-grid { grid-template-columns: repeat(2, 1fr); }
      .rating-row { grid-template-columns: 1fr; gap:6px; }
      .rating-meta { text-align:left; }
      .rating-track { height:22px; }
      .rating-chart-filter { width:100%; }
      .rating-chart-filter .btn { width:100%; }
      .rating-chart-filter select { width:100%; }
      .student-list-toolbar { flex-direction:column; align-items:stretch; }
      .student-list-actions { width:100%; }
      .student-list-actions .btn, .student-list-actions form { flex:1; min-width:0; }
      .student-list-actions .btn { width:100%; text-align:center; }
      .section-archive-grid { grid-template-columns: 1fr; }
    }
  </style>
  <div class="page-title">Hello, <%= user.name %>! 👋</div>
  <div class="page-sub">Manage students and track fitness progress.</div>

  <!-- Approve/Reject feedback -->
  <% if (approveSuccess) { %>
    <div class="alert alert-success" style="margin-bottom:16px;"><%= approveSuccess %></div>
  <% } %>
  <% if (approveError) { %>
    <div class="alert alert-error" style="margin-bottom:16px;"><%= approveError %></div>
  <% } %>

  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="label">Total Students</div>
      <div class="value"><%= stats.total %></div>
      <div class="sub"><%= stats.male %> male · <%= stats.female %> female</div>
    </div>
    <div class="stat-card">
      <div class="label">PATHFit 1</div>
      <div class="value"><%= stats.pf1 %></div>
      <div class="sub">enrolled students</div>
    </div>
    <div class="stat-card">
      <div class="label">PATHFit 2</div>
      <div class="value"><%= stats.pf2 %></div>
      <div class="sub">enrolled students</div>
    </div>
    <div class="stat-card <%= pendingScreenings > 0 ? 'warn' : '' %>">
      <div class="label">Pending Health Appraisals</div>
      <div class="value"><%= pendingScreenings %></div>
      <div class="sub">awaiting clearance</div>
    </div>
  </div>

  <!-- Section Management Panel -->
  <div class="card" style="margin-bottom:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid #e8ecf0;flex-wrap:wrap;gap:8px;">
      <div>
        <h3 style="margin:0;border:none;padding:0;">Section Code Management</h3>
        <div style="font-size:.82rem;color:#666;margin-top:3px;">Add, edit, or delete section codes that students see when registering.</div>
      </div>
      <button type="button" onclick="document.getElementById('addSectionForm').style.display=document.getElementById('addSectionForm').style.display==='none'?'flex':'none'" class="btn btn-sm">+ Add Section</button>
    </div>

    <!-- Add Section form (hidden by default) -->
    <form id="addSectionForm" method="POST" action="/instructor/sections" style="display:none;gap:10px;align-items:flex-end;flex-wrap:wrap;padding:14px;background:#f5f8fc;border-radius:8px;margin-bottom:14px;">
      <div style="flex:0 0 auto;">
        <label style="display:block;font-size:.8rem;font-weight:600;color:#042C53;margin-bottom:4px;">Section Code *</label>
        <input type="text" name="code" placeholder="e.g. BSIT-1A" maxlength="20" required
          style="padding:8px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.9rem;width:140px;text-transform:uppercase;">
      </div>
      <div style="flex:1;min-width:180px;">
        <label style="display:block;font-size:.8rem;font-weight:600;color:#042C53;margin-bottom:4px;">Description (optional)</label>
        <input type="text" name="description" placeholder="e.g. BS Information Technology 1A"
          style="width:100%;padding:8px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.9rem;box-sizing:border-box;">
      </div>
      <div style="display:flex;gap:8px;align-items:flex-end;">
        <button type="submit" class="btn btn-sm">Save</button>
        <button type="button" class="btn btn-sm btn-outline" onclick="document.getElementById('addSectionForm').style.display='none'">Cancel</button>
      </div>
    </form>

    <!-- Sections list -->
    <% const mSections = typeof managedSections !== 'undefined' ? managedSections : []; %>
    <% if (mSections.length > 0) { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;">
      <% mSections.forEach(function(sec) { %>
      <div style="background:#f8f9fb;border:1px solid #e0e8f0;border-radius:8px;padding:12px 14px;display:flex;flex-direction:column;gap:8px;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
          <div>
            <div style="font-size:.95rem;font-weight:800;color:#042C53;"><%= sec.code %></div>
            <% if (sec.description) { %><div style="font-size:.78rem;color:#666;margin-top:2px;"><%= sec.description %></div><% } %>
          </div>
          <div style="display:flex;gap:6px;flex-shrink:0;">
            <button type="button"
              class="edit-section-btn"
              data-section-id="<%= sec.section_id %>"
              data-code="<%= (sec.code||'') %>"
              data-description="<%= (sec.description||'') %>"
              style="padding:4px 10px;background:#185FA5;color:#fff;border:none;border-radius:5px;font-size:.75rem;font-weight:700;cursor:pointer;">Edit</button>
            <form method="POST" action="/instructor/sections/delete" onsubmit="return confirm('Delete section <%= sec.code %>? Students already in this section are not affected.')" style="margin:0;">
              <input type="hidden" name="section_id" value="<%= sec.section_id %>">
              <button type="submit" style="padding:4px 10px;background:#e53935;color:#fff;border:none;border-radius:5px;font-size:.75rem;font-weight:700;cursor:pointer;">Delete</button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
      <div class="empty-state" style="padding:20px 0;">No sections yet. Click "+ Add Section" to create the first one.</div>
    <% } %>
  </div>

  <!-- Edit Section Modal -->
  <div id="editSectionModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;height:100vh;background:rgba(4,44,83,.65);backdrop-filter:blur(4px);z-index:99999;overflow-y:auto;padding:24px 16px;">
    <div style="background:#fff;border-radius:14px;width:100%;max-width:440px;margin:0 auto;box-shadow:0 20px 60px rgba(4,44,83,.3);">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:18px 22px 14px;border-bottom:1px solid #e8ecf0;">
        <div style="font-size:1rem;font-weight:700;color:#042C53;">✏️ Edit Section</div>
        <button type="button" onclick="closeEditSection()" style="background:none;border:none;font-size:1.5rem;color:#aaa;cursor:pointer;">&times;</button>
      </div>
      <form method="POST" action="/instructor/sections/update" style="padding:20px 22px;">
        <input type="hidden" name="section_id" id="editSectionId">
        <div class="form-group">
          <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Section Code *</label>
          <input type="text" name="code" id="editSectionCode" maxlength="20" required
            style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;text-transform:uppercase;">
        </div>
        <div class="form-group">
          <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Description (optional)</label>
          <input type="text" name="description" id="editSectionDesc"
            style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
        </div>
        <div style="display:flex;gap:10px;margin-top:16px;">
          <button type="submit" class="btn" style="flex:1;">💾 Save</button>
          <button type="button" onclick="closeEditSection()" class="btn btn-outline">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Section Rating Distribution (moved from Reports) -->
  <div class="card rating-chart-card">
    <%
      const chartDist = (ratingDistribution && ratingDistribution.dist) || {};
      const chartTotal = (ratingDistribution && ratingDistribution.totalTests) || 0;
      const chartSection = (ratingDistribution && ratingDistribution.selectedSection) || '';
      const chartSections = (ratingDistribution && ratingDistribution.sections) || [];
      const ratingRows = [
        { key: 'excellent', label: 'Excellent' },
        { key: 'very_good', label: 'Very Good' },
        { key: 'good', label: 'Good' },
        { key: 'fair', label: 'Fair' },
        { key: 'needs_improvement', label: 'Needs Improvement' },
        { key: 'poor', label: 'Poor' },
      ];
    %>
    <div class="rating-chart-head">
      <div>
        <h3 style="margin:0;border:none;padding:0;">Section Rating Distribution</h3>
        <div class="rating-chart-sub">
          <% if (chartSection) { %>
            Based on fitness test ratings in section <strong><%= chartSection %></strong>.
          <% } else { %>
            No section data available yet.
          <% } %>
        </div>
      </div>
      <form method="GET" action="/instructor/dashboard" class="rating-chart-filter">
        <input type="hidden" name="section" value="<%= filters.section || '' %>">
        <input type="hidden" name="course" value="<%= filters.course || '' %>">
        <input type="hidden" name="year_level" value="<%= filters.year_level || '' %>">
        <input type="hidden" name="pathfit_level" value="<%= filters.pathfit_level || '' %>">
        <input type="hidden" name="gender" value="<%= filters.gender || '' %>">
        <input type="hidden" name="search" value="<%= filters.search || '' %>">
        <input type="hidden" name="show_archived" value="<%= showArchived ? '1' : '' %>">
        <div>
          <label for="ratingSection">Section</label>
          <select id="ratingSection" name="rating_section" <%= chartSections.length ? '' : 'disabled' %>>
            <% if (!chartSections.length) { %>
              <option value="">No sections</option>
            <% } else { %>
              <% chartSections.forEach(sec => { %>
                <option value="<%= sec %>" <%= sec === chartSection ? 'selected' : '' %>><%= sec %></option>
              <% }) %>
            <% } %>
          </select>
        </div>
        <button type="submit" class="btn btn-sm btn-outline" <%= chartSections.length ? '' : 'disabled' %>>Apply</button>
      </form>
    </div>

    <% if (chartSection) { %>
      <div class="rating-bars">
        <% ratingRows.forEach(row => {
          const cnt = chartDist[row.key] || 0;
          const pct = chartTotal > 0 ? Math.round((cnt / chartTotal) * 100) : 0;
        %>
          <div class="rating-row">
            <span class="badge badge-<%= row.key %>"><%= row.label %></span>
            <div class="rating-track" role="img" aria-label="<%= row.label %>: <%= cnt %> tests, <%= pct %> percent">
              <div class="rating-fill <%= row.key %>" style="width:<%= pct %>%;">
                <%= pct > 14 ? (pct + '%') : '' %>
              </div>
            </div>
            <div class="rating-meta"><%= cnt %> · <%= pct %>%</div>
          </div>
        <% }) %>
      </div>
      <div style="margin-top:10px;font-size:.82rem;color:#6b7280;">Total tests counted: <strong><%= chartTotal %></strong></div>
    <% } else { %>
      <div class="empty-state">No section ratings to display yet.</div>
    <% } %>
  </div>

  <!-- Students Table -->
  <div class="card">
    <div class="student-list-toolbar">
      <h3 style="margin:0;border:none;padding:0;">
        <%= showArchived ? 'Archived Students' : 'Student List' %>
        <span style="font-size:.82rem;font-weight:400;color:#555;margin-left:8px;"><%= students.length %> student(s)</span>
      </h3>
      <div class="student-list-actions">
        <% if (!showArchived && students.length > 0) { %>
        <button type="button" onclick="exportToExcel()" class="btn btn-sm" style="background:#1e7e34;border-color:#1e7e34;">Export to Excel</button>
        <% } %>
        <% if (showArchived) { %>
          <a href="/instructor/dashboard?<%= [
            filters.section ? 'section=' + encodeURIComponent(filters.section) : '',
            filters.course ? 'course=' + encodeURIComponent(filters.course) : '',
            filters.year_level ? 'year_level=' + encodeURIComponent(filters.year_level) : '',
            filters.pathfit_level ? 'pathfit_level=' + encodeURIComponent(filters.pathfit_level) : '',
            filters.rating_section ? 'rating_section=' + encodeURIComponent(filters.rating_section) : ''
          ].filter(Boolean).join('&') %>" class="btn btn-sm btn-outline">View Active Students</a>
        <% } else { %>
          <a href="/instructor/dashboard?show_archived=1<%= filters.section ? '&section=' + encodeURIComponent(filters.section) : '' %><%= filters.course ? '&course=' + encodeURIComponent(filters.course) : '' %><%= filters.year_level ? '&year_level=' + encodeURIComponent(filters.year_level) : '' %><%= filters.pathfit_level ? '&pathfit_level=' + encodeURIComponent(filters.pathfit_level) : '' %><%= filters.rating_section ? '&rating_section=' + encodeURIComponent(filters.rating_section) : '' %>" class="btn btn-sm btn-outline">View Archived</a>
        <% } %>
      </div>
    </div>

    <form method="GET" action="/instructor/dashboard" class="student-filter-bar">
      <% if (showArchived) { %><input type="hidden" name="show_archived" value="1"><% } %>
      <input type="hidden" name="rating_section" value="<%= filters.rating_section || '' %>">
      <div class="filter-bar">
        <div class="fg">
          <label>Institute / Course</label>
          <select name="course">
            <option value="">All Institutes</option>
            <option value="IBM" <%= filters.course==='IBM'?'selected':'' %>>IBM (Institute For Business Management)</option>
            <option value="ICS" <%= filters.course==='ICS'?'selected':'' %>>ICS (Institute For Computer Studies)</option>
            <option value="ITE" <%= filters.course==='ITE'?'selected':'' %>>ITE (Institute For Teacher Education)</option>
          </select>
        </div>
        <div class="fg">
          <label>Section Code:</label>
          <%
            const _archiveStatsForFilter = sectionArchiveStats || [];
            const _baseCodes = ['A','B','C','D','E','F','G','H','I','J','K','L','M'];
            const _sectionOptions = Array.from(new Set(
              _baseCodes.concat(_archiveStatsForFilter.map(s => s.code).filter(Boolean))
            )).sort();
          %>
          <input
            type="text"
            name="section"
            value="<%= filters.section || '' %>"
            list="sectionFilterCodes"
            placeholder="All Section Codes"
            autocomplete="off"
            style="width:100%;padding:8px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;text-transform:uppercase;">
          <datalist id="sectionFilterCodes">
            <% _sectionOptions.forEach(code => { %>
              <option value="<%= code %>"></option>
            <% }) %>
          </datalist>
        </div>
        <div class="fg">
          <label>Year Level</label>
          <select name="year_level">
            <option value="">All Year</option>
            <option value="1" <%= filters.year_level==='1'?'selected':'' %>>1st Year</option>
            <option value="2" <%= filters.year_level==='2'?'selected':'' %>>2nd Year</option>
            <option value="3" <%= filters.year_level==='3'?'selected':'' %>>3rd Year</option>
            <option value="4" <%= filters.year_level==='4'?'selected':'' %>>4th Year</option>
          </select>
        </div>
        <div class="fg">
          <label>PATHFit Level</label>
          <select name="pathfit_level">
            <option value="">All Levels</option>
            <option value="1" <%= filters.pathfit_level==='1'?'selected':'' %>>PATHFit 1</option>
            <option value="2" <%= filters.pathfit_level==='2'?'selected':'' %>>PATHFit 2</option>
          </select>
        </div>
        <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;">
          <button type="submit" class="btn">Filter</button>
          <a href="/instructor/dashboard<%= showArchived ? '?show_archived=1' : '' %>" class="btn btn-outline">Reset</a>
        </div>
      </div>
    </form>

    <% const archiveStats = sectionArchiveStats || []; %>
    <div class="section-archive-panel">
      <h4><%= showArchived ? 'Restore by Section' : 'Archive by Section' %></h4>
      <p><%= showArchived ? 'Restore every archived student in a section back to the active list.' : 'Archive all active students in a section at once (e.g. Section A, B, or C).' %></p>
      <% if (archiveStats.length) { %>
      <div class="section-archive-grid">
        <% archiveStats.forEach(function(sec) {
          const count = showArchived ? sec.archived : sec.active;
          const canAct = showArchived ? sec.archived > 0 : sec.active > 0;
        %>
        <div class="section-archive-card">
          <span class="section-archive-code">Section <%= sec.code %></span>
          <span class="section-archive-count"><%= count %> student<%= count === 1 ? '' : 's' %></span>
          <% if (canAct) { %>
            <% if (showArchived) { %>
            <form method="POST" action="/instructor/restore-section" onsubmit="return confirm('Restore all archived students in section <%= sec.code %>?');">
              <input type="hidden" name="section" value="<%= sec.code %>">
              <input type="hidden" name="course" value="<%= filters.course || '' %>">
              <input type="hidden" name="year_level" value="<%= filters.year_level || '' %>">
              <input type="hidden" name="pathfit_level" value="<%= filters.pathfit_level || '' %>">
              <input type="hidden" name="rating_section" value="<%= filters.rating_section || '' %>">
              <input type="hidden" name="show_archived" value="1">
              <button type="submit" class="btn-restore">Restore All</button>
            </form>
            <% } else { %>
            <form method="POST" action="/instructor/archive-section" onsubmit="return confirm('Archive all <%= sec.active %> active student(s) in section <%= sec.code %>?');">
              <input type="hidden" name="section" value="<%= sec.code %>">
              <input type="hidden" name="course" value="<%= filters.course || '' %>">
              <input type="hidden" name="year_level" value="<%= filters.year_level || '' %>">
              <input type="hidden" name="pathfit_level" value="<%= filters.pathfit_level || '' %>">
              <input type="hidden" name="rating_section" value="<%= filters.rating_section || '' %>">
              <button type="submit" class="btn-archive">Archive All</button>
            </form>
            <% } %>
          <% } else { %>
            <span class="section-archive-count" style="font-style:italic;">No students to <%= showArchived ? 'restore' : 'archive' %></span>
          <% } %>
        </div>
        <% }) %>
      </div>
      <% } else { %>
        <div class="empty-state" style="padding:12px 0;">No sections with students yet.</div>
      <% } %>
    </div>

    <% if (students.length > 0) { %>
    <div class="table-wrap">
      <table id="studentTable">
        <thead>
          <tr><th>Student ID</th><th>Name</th><th>Email</th><th>Section Code</th><th>Course</th><th>Year Level</th><th>Gender</th><th>Age</th><th>PATHFit</th><th></th></tr>
        </thead>
        <tbody>
          <% students.forEach(s => { %>
          <tr>
            <td><%= s.student_id||'—' %></td>
            <td><strong><%= s.name %></strong></td>
            <td><%= s.email %></td>
            <td><%= s.section||'—' %></td>
            <td><%= s.course||'—' %></td>
            <td><%= s.year_level ? s.year_level + (s.year_level==1?'st':s.year_level==2?'nd':s.year_level==3?'rd':'th') + ' Year' : '—' %></td>
            <td><span class="badge badge-<%= s.gender %>"><%= (s.gender||'').charAt(0).toUpperCase()+(s.gender||'').slice(1) %></span></td>
            <td><%= s.age||'—' %></td>
            <td><span class="badge badge-<%= s.pathfit_level %>">PATHFit <%= s.pathfit_level %></span></td>
            <td>
              <% if (!showArchived) { %>
              <button type="button"
                class="edit-student-btn"
                data-user-id="<%= s.user_id %>"
                data-name="<%= (s.name||'').replace(/"/g,'&quot;') %>"
                data-student-id="<%= s.student_id||'' %>"
                data-email="<%= s.email||'' %>"
                data-gender="<%= s.gender||'' %>"
                data-age="<%= s.age||'' %>"
                data-course="<%= s.course||'' %>"
                data-section="<%= s.section||'' %>"
                data-year-level="<%= s.year_level||'' %>"
                data-pathfit-level="<%= s.pathfit_level||'' %>"
                style="padding:5px 14px;background:#185FA5;color:#fff;border:none;border-radius:5px;font-size:.82rem;font-weight:700;cursor:pointer;">
                ✏️ Edit
              </button>
              <% } else { %>
              <span style="font-size:.8rem;color:#888;">Use Restore by Section above</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <div class="empty-state"><%= showArchived ? 'No archived students found for the selected filters.' : 'No students found matching the selected filters.' %></div>
    <% } %>
  </div>
</div>

<!-- SheetJS CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script>
const EXPORT_STUDENTS = <%- JSON.stringify(students.map((s, i) => ({
  no:         i + 1,
  student_id: s.student_id || '—',
  name:       s.name,
  email:      s.email,
  section:    s.section || '—',
  course:     s.course  || '—',
  year_level: s.year_level
    ? s.year_level + (s.year_level==1?'st':s.year_level==2?'nd':s.year_level==3?'rd':'th') + ' Year'
    : '—',
  year_sort:  s.year_level || 99,
  gender:     s.gender ? s.gender.charAt(0).toUpperCase() + s.gender.slice(1) : '—',
  age:        s.age || '—',
  pathfit:    s.pathfit_level ? 'PATHFit ' + s.pathfit_level : '—',
}))) %>;

function exportToExcel() {
  const sorted = [...EXPORT_STUDENTS].sort((a, b) => {
    if (a.section   < b.section)   return -1;
    if (a.section   > b.section)   return  1;
    if (a.year_sort < b.year_sort) return -1;
    if (a.year_sort > b.year_sort) return  1;
    return a.name.localeCompare(b.name);
  });

  const wsData = [
    ['PATHFIT TRACKING SYSTEM — Student List'],
    ['NBSC · Generated: ' + new Date().toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' })],
    [],
    ['No.', 'Student ID', 'Full Name', 'Email', 'Section', 'Course', 'Year Level', 'Gender', 'Age', 'PATHFit Level'],
    ...sorted.map(s => [s.no, s.student_id, s.name, s.email, s.section, s.course, s.year_level, s.gender, s.age, s.pathfit]),
    [],
    ['Total Students: ' + sorted.length],
  ];

  const ws = XLSX.utils.aoa_to_sheet(wsData);
  ws['!cols'] = [
    { wch: 5  }, { wch: 14 }, { wch: 30 }, { wch: 28 },
    { wch: 10 }, { wch: 10 }, { wch: 14 }, { wch: 10 }, { wch: 6 }, { wch: 14 },
  ];
  ws['!merges'] = [
    { s: { r: 0, c: 0 }, e: { r: 0, c: 9 } },
    { s: { r: 1, c: 0 }, e: { r: 1, c: 9 } },
  ];

  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Student List');

  const now    = new Date().toISOString().slice(0, 10);
  const suffix = [
    '<%= filters.section    ? "Sec-" + filters.section    : "" %>',
    '<%= filters.year_level ? "Yr"   + filters.year_level : "" %>',
    '<%= filters.course     ? filters.course              : "" %>',
    '<%= filters.gender     ? filters.gender              : "" %>',
  ].filter(Boolean).join('_');

  XLSX.writeFile(wb, 'StudentList_' + now + (suffix ? '_' + suffix : '') + '.xlsx');
}
</script>

<!-- ── Edit Student Modal ── -->
<div id="editStudentModal" style="
  display:none; position:fixed; top:0; left:0; right:0; bottom:0;
  width:100vw; height:100vh; background:rgba(4,44,83,.65);
  backdrop-filter:blur(4px); z-index:99999; overflow-y:auto; padding:24px 16px;">
  <div style="background:#fff;border-radius:16px;width:100%;max-width:560px;margin:0 auto;box-shadow:0 24px 64px rgba(4,44,83,.35);">

    <!-- Header -->
    <div style="display:flex;justify-content:space-between;align-items:flex-start;padding:22px 24px 16px;border-bottom:1px solid #e8ecf0;">
      <div>
        <div style="font-size:1.08rem;font-weight:700;color:#042C53;">✏️ Edit Student Information</div>
        <div style="font-size:.8rem;color:#888;margin-top:3px;">Update personal and academic details for this student.</div>
      </div>
      <button id="editModalCloseBtn" type="button" style="background:none;border:none;font-size:1.6rem;color:#aaa;cursor:pointer;line-height:1;padding:0 4px;">&times;</button>
    </div>

    <!-- Form -->
    <form method="POST" action="/instructor/edit-student">
      <input type="hidden" name="user_id" id="editUserId">

      <div style="padding:20px 24px;">

        <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;color:#185FA5;font-weight:700;margin-bottom:12px;padding-bottom:6px;border-bottom:1px solid #e8ecf0;">
          Personal Information
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;">
          <div style="grid-column:1/-1;">
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Full Name *</label>
            <input type="text" name="name" id="editName" required
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Student ID</label>
            <input type="text" name="student_id" id="editStudentId"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Email *</label>
            <input type="email" name="email" id="editEmail" required
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Gender</label>
            <select name="gender" id="editGender"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
              <option value="">— Select —</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Age</label>
            <input type="number" name="age" id="editAge" min="1" max="120" placeholder="e.g. 18"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
          </div>
        </div>

        <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;color:#185FA5;font-weight:700;margin-bottom:12px;padding-bottom:6px;border-bottom:1px solid #e8ecf0;">
          Academic Information
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Institute / Course</label>
            <select name="course" id="editCourse"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
              <option value="">— Select —</option>
              <option value="IBM">IBM</option>
              <option value="ICS">ICS</option>
              <option value="ITE">ITE</option>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Section Code:</label>
            <input
              type="text"
              name="section"
              id="editSection"
              list="editSectionCodes"
              placeholder="Type section code…"
              autocomplete="off"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;text-transform:uppercase;">
            <datalist id="editSectionCodes">
              <% _sectionOptions.forEach(code => { %>
                <option value="<%= code %>"></option>
              <% }) %>
            </datalist>
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Year Level</label>
            <select name="year_level" id="editYearLevel"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
              <option value="">— Select —</option>
              <option value="1">1st Year</option>
              <option value="2">2nd Year</option>
              <option value="3">3rd Year</option>
              <option value="4">4th Year</option>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">PATHFit Level</label>
            <select name="pathfit_level" id="editPathfitLevel"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
              <option value="">— Select —</option>
              <option value="1">PATHFit 1</option>
              <option value="2">PATHFit 2</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div style="display:flex;gap:10px;padding:16px 24px 20px;border-top:1px solid #e8ecf0;">
        <button type="submit" style="flex:1;padding:10px 20px;background:#185FA5;color:#fff;border:none;border-radius:7px;font-size:.92rem;font-weight:700;cursor:pointer;">
          💾 Save Changes
        </button>
        <button type="button" id="editModalCancelBtn" style="padding:10px 20px;background:transparent;border:2px solid #cdd5e0;color:#555;border-radius:7px;font-size:.92rem;font-weight:700;cursor:pointer;">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  var modal = document.getElementById('editStudentModal');

  function openEditModal(btn) {
    document.getElementById('editUserId').value       = btn.dataset.userId;
    document.getElementById('editName').value         = btn.dataset.name;
    document.getElementById('editStudentId').value    = btn.dataset.studentId;
    document.getElementById('editEmail').value        = btn.dataset.email;
    document.getElementById('editGender').value       = btn.dataset.gender;
    document.getElementById('editAge').value          = btn.dataset.age;
    document.getElementById('editCourse').value       = btn.dataset.course;
    document.getElementById('editSection').value      = (btn.dataset.section || '').toUpperCase();
    document.getElementById('editYearLevel').value    = btn.dataset.yearLevel;
    document.getElementById('editPathfitLevel').value = btn.dataset.pathfitLevel;
    modal.scrollTop = 0;
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
  }

  function closeEditModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  // Wire up all Edit buttons
  document.querySelectorAll('.edit-student-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { openEditModal(btn); });
  });

  // Close buttons
  document.getElementById('editModalCloseBtn').addEventListener('click', closeEditModal);
  document.getElementById('editModalCancelBtn').addEventListener('click', closeEditModal);

  // Close on backdrop click
  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeEditModal();
  });

  // Close on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { closeEditModal(); closeEditSection(); }
  });
})();

// ── Section Edit Modal ────────────────────────────────────
function openEditSection(id, code, desc) {
  document.getElementById('editSectionId').value   = id;
  document.getElementById('editSectionCode').value = code;
  document.getElementById('editSectionDesc').value = desc;
  var m = document.getElementById('editSectionModal');
  m.scrollTop = 0;
  m.style.display = 'block';
  document.body.style.overflow = 'hidden';
}
function closeEditSection() {
  document.getElementById('editSectionModal').style.display = 'none';
  document.body.style.overflow = '';
}
document.getElementById('editSectionModal').addEventListener('click', function(e) {
  if (e.target === this) closeEditSection();
});

// Auto-uppercase section code input while typing
document.addEventListener('DOMContentLoaded', function() {
  // Wire up edit-section buttons using data-* attributes (no inline onclick)
  document.querySelectorAll('.edit-section-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      openEditSection(btn.dataset.sectionId, btn.dataset.code, btn.dataset.description);
    });
  });

  var addCodeInput = document.querySelector('#addSectionForm input[name="code"]');
  if (addCodeInput) addCodeInput.addEventListener('input', function() { this.value = this.value.toUpperCase(); });
  var editCodeInput = document.getElementById('editSectionCode');
  if (editCodeInput) editCodeInput.addEventListener('input', function() { this.value = this.value.toUpperCase(); });
});
</script>

