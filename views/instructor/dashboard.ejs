<%- include('../partials/header', { title: 'Instructor Dashboard' }) %>
<div class="container">
  <div class="page-title">Hello, <%= user.name %>! 👋</div>
  <div class="page-sub">Manage students and track fitness progress.</div>

  <!-- Approve/Reject feedback -->
  <% if (approveSuccess) { %>
    <div class="alert alert-success" style="margin-bottom:16px;"><%= approveSuccess %></div>
  <% } %>
  <% if (approveError) { %>
    <div class="alert alert-error" style="margin-bottom:16px;"><%= approveError %></div>
  <% } %>

  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="label">Total Students</div>
      <div class="value"><%= stats.total %></div>
      <div class="sub"><%= stats.male %> male · <%= stats.female %> female</div>
    </div>
    <div class="stat-card">
      <div class="label">PATHFit 1</div>
      <div class="value"><%= stats.pf1 %></div>
      <div class="sub">enrolled students</div>
    </div>
    <div class="stat-card">
      <div class="label">PATHFit 2</div>
      <div class="value"><%= stats.pf2 %></div>
      <div class="sub">enrolled students</div>
    </div>
    <div class="stat-card <%= pendingScreenings > 0 ? 'warn' : '' %>">
      <div class="label">Pending Health Appraisals</div>
      <div class="value"><%= pendingScreenings %></div>
      <div class="sub">awaiting clearance</div>
    </div>
  </div>

  <!-- Filter -->
  <form method="GET" action="/instructor/dashboard">
    <div class="filter-bar">
      <div class="fg">
        <label>Institute / Course</label>
        <select name="course">
          <option value="">All Institutes</option>
          <option value="IBM" <%= filters.course==='IBM'?'selected':'' %>>IBM (Institute For Business Management)</option>
          <option value="ICS" <%= filters.course==='ICS'?'selected':'' %>>ICS (Institute For Computer Studies)</option>
          <option value="ITE" <%= filters.course==='ITE'?'selected':'' %>>ITE (Institute For Teacher Education)</option>
        </select>
      </div>
      <div class="fg">
        <label>Section Code:</label>
        <select name="section">
          <option value="">All Section Codes</option>
          <option value="A" <%= filters.section==='A'?'selected':'' %>>A</option>
          <option value="B" <%= filters.section==='B'?'selected':'' %>>B</option>
          <option value="C" <%= filters.section==='C'?'selected':'' %>>C</option>
          <option value="D" <%= filters.section==='D'?'selected':'' %>>D</option>
          <option value="E" <%= filters.section==='E'?'selected':'' %>>E</option>
          <option value="F" <%= filters.section==='F'?'selected':'' %>>F</option>
          <option value="G" <%= filters.section==='G'?'selected':'' %>>G</option>
          <option value="H" <%= filters.section==='H'?'selected':'' %>>H</option>
          <option value="I" <%= filters.section==='I'?'selected':'' %>>I</option>
          <option value="J" <%= filters.section==='J'?'selected':'' %>>J</option>
          <option value="K" <%= filters.section==='K'?'selected':'' %>>K</option>
          <option value="L" <%= filters.section==='L'?'selected':'' %>>L</option>
          <option value="M" <%= filters.section==='M'?'selected':'' %>>M</option>
        </select>
      </div>
      <div class="fg">
        <label>Year Level</label>
        <select name="year_level">
          <option value="">All Year</option>
          <option value="1" <%= filters.year_level==='1'?'selected':'' %>>1st Year</option>
          <option value="2" <%= filters.year_level==='2'?'selected':'' %>>2nd Year</option>
          <option value="3" <%= filters.year_level==='3'?'selected':'' %>>3rd Year</option>
          <option value="4" <%= filters.year_level==='4'?'selected':'' %>>4th Year</option>
        </select>
      </div>
      <div class="fg">
        <label>PATHFit Level</label>
        <select name="pathfit_level">
          <option value="">All Levels</option>
          <option value="1" <%= filters.pathfit_level==='1'?'selected':'' %>>PATHFit 1</option>
          <option value="2" <%= filters.pathfit_level==='2'?'selected':'' %>>PATHFit 2</option>
        </select>
      </div>
      <div style="display:flex;gap:8px;align-items:flex-end;">
        <button type="submit" class="btn">Filter</button>
        <a href="/instructor/dashboard" class="btn btn-outline">Reset</a>
      </div>
    </div>
  </form>

  <!-- Students Table -->
  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid #e8ecf0;">
      <h3 style="margin:0;border:none;padding:0;">
        Student List
        <span style="font-size:.82rem;font-weight:400;color:#555;margin-left:8px;"><%= students.length %> student(s)</span>
      </h3>
      <% if (students.length > 0) { %>
      <button onclick="exportToExcel()" style="display:inline-flex;align-items:center;gap:7px;padding:8px 16px;background:#1e7e34;color:#fff;border:none;border-radius:7px;font-size:.88rem;font-weight:700;cursor:pointer;transition:background .2s;" onmouseover="this.style.background='#155724'" onmouseout="this.style.background='#1e7e34'">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
        </svg>
        Export to Excel
      </button>
      <% } %>
    </div>

    <% if (students.length > 0) { %>
    <div class="table-wrap">
      <table id="studentTable">
        <thead>
          <tr><th>Student ID</th><th>Name</th><th>Email</th><th>Section Code</th><th>Course</th><th>Year Level</th><th>Gender</th><th>Age</th><th>PATHFit</th><th></th></tr>
        </thead>
        <tbody>
          <% students.forEach(s => { %>
          <tr>
            <td><%= s.student_id||'—' %></td>
            <td><strong><%= s.name %></strong></td>
            <td><%= s.email %></td>
            <td><%= s.section||'—' %></td>
            <td><%= s.course||'—' %></td>
            <td><%= s.year_level ? s.year_level + (s.year_level==1?'st':s.year_level==2?'nd':s.year_level==3?'rd':'th') + ' Year' : '—' %></td>
            <td><span class="badge badge-<%= s.gender %>"><%= (s.gender||'').charAt(0).toUpperCase()+(s.gender||'').slice(1) %></span></td>
            <td><%= s.age||'—' %></td>
            <td><span class="badge badge-<%= s.pathfit_level %>">PATHFit <%= s.pathfit_level %></span></td>
            <td>
              <button type="button"
                class="edit-student-btn"
                data-user-id="<%= s.user_id %>"
                data-name="<%= (s.name||'').replace(/"/g,'&quot;') %>"
                data-student-id="<%= s.student_id||'' %>"
                data-email="<%= s.email||'' %>"
                data-gender="<%= s.gender||'' %>"
                data-age="<%= s.age||'' %>"
                data-course="<%= s.course||'' %>"
                data-section="<%= s.section||'' %>"
                data-year-level="<%= s.year_level||'' %>"
                data-pathfit-level="<%= s.pathfit_level||'' %>"
                style="padding:5px 14px;background:#185FA5;color:#fff;border:none;border-radius:5px;font-size:.82rem;font-weight:700;cursor:pointer;">
                ✏️ Edit
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <div class="empty-state">No students found matching the selected filters.</div>
    <% } %>
  </div>
</div>

<!-- SheetJS CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script>
const EXPORT_STUDENTS = <%- JSON.stringify(students.map((s, i) => ({
  no:         i + 1,
  student_id: s.student_id || '—',
  name:       s.name,
  email:      s.email,
  section:    s.section || '—',
  course:     s.course  || '—',
  year_level: s.year_level
    ? s.year_level + (s.year_level==1?'st':s.year_level==2?'nd':s.year_level==3?'rd':'th') + ' Year'
    : '—',
  year_sort:  s.year_level || 99,
  gender:     s.gender ? s.gender.charAt(0).toUpperCase() + s.gender.slice(1) : '—',
  age:        s.age || '—',
  pathfit:    s.pathfit_level ? 'PATHFit ' + s.pathfit_level : '—',
}))) %>;

function exportToExcel() {
  const sorted = [...EXPORT_STUDENTS].sort((a, b) => {
    if (a.section   < b.section)   return -1;
    if (a.section   > b.section)   return  1;
    if (a.year_sort < b.year_sort) return -1;
    if (a.year_sort > b.year_sort) return  1;
    return a.name.localeCompare(b.name);
  });

  const wsData = [
    ['PATHFIT TRACKING SYSTEM — Student List'],
    ['NBSC · Generated: ' + new Date().toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' })],
    [],
    ['No.', 'Student ID', 'Full Name', 'Email', 'Section', 'Course', 'Year Level', 'Gender', 'Age', 'PATHFit Level'],
    ...sorted.map(s => [s.no, s.student_id, s.name, s.email, s.section, s.course, s.year_level, s.gender, s.age, s.pathfit]),
    [],
    ['Total Students: ' + sorted.length],
  ];

  const ws = XLSX.utils.aoa_to_sheet(wsData);
  ws['!cols'] = [
    { wch: 5  }, { wch: 14 }, { wch: 30 }, { wch: 28 },
    { wch: 10 }, { wch: 10 }, { wch: 14 }, { wch: 10 }, { wch: 6 }, { wch: 14 },
  ];
  ws['!merges'] = [
    { s: { r: 0, c: 0 }, e: { r: 0, c: 9 } },
    { s: { r: 1, c: 0 }, e: { r: 1, c: 9 } },
  ];

  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Student List');

  const now    = new Date().toISOString().slice(0, 10);
  const suffix = [
    '<%= filters.section    ? "Sec-" + filters.section    : "" %>',
    '<%= filters.year_level ? "Yr"   + filters.year_level : "" %>',
    '<%= filters.course     ? filters.course              : "" %>',
    '<%= filters.gender     ? filters.gender              : "" %>',
  ].filter(Boolean).join('_');

  XLSX.writeFile(wb, 'StudentList_' + now + (suffix ? '_' + suffix : '') + '.xlsx');
}
</script>

<!-- ── Edit Student Modal ── -->
<div id="editStudentModal" style="
  display:none; position:fixed; top:0; left:0; right:0; bottom:0;
  width:100vw; height:100vh; background:rgba(4,44,83,.65);
  backdrop-filter:blur(4px); z-index:99999; overflow-y:auto; padding:24px 16px;">
  <div style="background:#fff;border-radius:16px;width:100%;max-width:560px;margin:0 auto;box-shadow:0 24px 64px rgba(4,44,83,.35);">

    <!-- Header -->
    <div style="display:flex;justify-content:space-between;align-items:flex-start;padding:22px 24px 16px;border-bottom:1px solid #e8ecf0;">
      <div>
        <div style="font-size:1.08rem;font-weight:700;color:#042C53;">✏️ Edit Student Information</div>
        <div style="font-size:.8rem;color:#888;margin-top:3px;">Update personal and academic details for this student.</div>
      </div>
      <button id="editModalCloseBtn" type="button" style="background:none;border:none;font-size:1.6rem;color:#aaa;cursor:pointer;line-height:1;padding:0 4px;">&times;</button>
    </div>

    <!-- Form -->
    <form method="POST" action="/instructor/edit-student">
      <input type="hidden" name="user_id" id="editUserId">

      <div style="padding:20px 24px;">

        <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;color:#185FA5;font-weight:700;margin-bottom:12px;padding-bottom:6px;border-bottom:1px solid #e8ecf0;">
          Personal Information
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;">
          <div style="grid-column:1/-1;">
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Full Name *</label>
            <input type="text" name="name" id="editName" required
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Student ID</label>
            <input type="text" name="student_id" id="editStudentId"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Email *</label>
            <input type="email" name="email" id="editEmail" required
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Gender</label>
            <select name="gender" id="editGender"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
              <option value="">— Select —</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Age</label>
            <input type="number" name="age" id="editAge" min="1" max="120" placeholder="e.g. 18"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
          </div>
        </div>

        <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;color:#185FA5;font-weight:700;margin-bottom:12px;padding-bottom:6px;border-bottom:1px solid #e8ecf0;">
          Academic Information
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Institute / Course</label>
            <select name="course" id="editCourse"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
              <option value="">— Select —</option>
              <option value="IBM">IBM</option>
              <option value="ICS">ICS</option>
              <option value="ITE">ITE</option>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Section Code:</label>
            <select name="section" id="editSection"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
              <option value="">— Select —</option>
              <option value="A">A</option>
              <option value="B">B</option>
              <option value="C">C</option>
              <option value="D">D</option>
              <option value="E">E</option>
              <option value="F">F</option>
              <option value="G">G</option>
              <option value="H">H</option>
              <option value="I">I</option>
              <option value="J">J</option>
              <option value="K">K</option>
              <option value="L">L</option>
              <option value="M">M</option>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">Year Level</label>
            <select name="year_level" id="editYearLevel"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
              <option value="">— Select —</option>
              <option value="1">1st Year</option>
              <option value="2">2nd Year</option>
              <option value="3">3rd Year</option>
              <option value="4">4th Year</option>
            </select>
          </div>
          <div>
            <label style="display:block;font-size:.82rem;font-weight:600;color:#042C53;margin-bottom:4px;">PATHFit Level</label>
            <select name="pathfit_level" id="editPathfitLevel"
              style="width:100%;padding:9px 12px;border:1.5px solid #cdd5e0;border-radius:7px;font-size:.92rem;box-sizing:border-box;">
              <option value="">— Select —</option>
              <option value="1">PATHFit 1</option>
              <option value="2">PATHFit 2</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div style="display:flex;gap:10px;padding:16px 24px 20px;border-top:1px solid #e8ecf0;">
        <button type="submit" style="flex:1;padding:10px 20px;background:#185FA5;color:#fff;border:none;border-radius:7px;font-size:.92rem;font-weight:700;cursor:pointer;">
          💾 Save Changes
        </button>
        <button type="button" id="editModalCancelBtn" style="padding:10px 20px;background:transparent;border:2px solid #cdd5e0;color:#555;border-radius:7px;font-size:.92rem;font-weight:700;cursor:pointer;">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  var modal = document.getElementById('editStudentModal');

  function openEditModal(btn) {
    document.getElementById('editUserId').value       = btn.dataset.userId;
    document.getElementById('editName').value         = btn.dataset.name;
    document.getElementById('editStudentId').value    = btn.dataset.studentId;
    document.getElementById('editEmail').value        = btn.dataset.email;
    document.getElementById('editGender').value       = btn.dataset.gender;
    document.getElementById('editAge').value          = btn.dataset.age;
    document.getElementById('editCourse').value       = btn.dataset.course;
    document.getElementById('editSection').value      = btn.dataset.section;
    document.getElementById('editYearLevel').value    = btn.dataset.yearLevel;
    document.getElementById('editPathfitLevel').value = btn.dataset.pathfitLevel;
    modal.scrollTop = 0;
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
  }

  function closeEditModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  // Wire up all Edit buttons
  document.querySelectorAll('.edit-student-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { openEditModal(btn); });
  });

  // Close buttons
  document.getElementById('editModalCloseBtn').addEventListener('click', closeEditModal);
  document.getElementById('editModalCancelBtn').addEventListener('click', closeEditModal);

  // Close on backdrop click
  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeEditModal();
  });

  // Close on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeEditModal();
  });
})();
</script>

<%- include('../partials/footer') %>
