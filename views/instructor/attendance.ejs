<%- include('../partials/header', { title: 'Attendance Tracker' }) %>
<div class="container">
  <a href="/instructor/dashboard" class="back-link">← Back to Dashboard</a>
  <div class="page-title">Attendance Tracker</div>
  <div class="page-sub">Record weekly attendance and monitor students below the 75% threshold.</div>

  <!-- Filter -->
  <form method="GET" action="/instructor/attendance">
    <div class="filter-bar">
      <div class="fg">
        <label>Section</label>
        <select name="section">
          <option value="">All Sections</option>
          <% sections.forEach(s => { %>
            <option value="<%= s %>" <%= filters.section===s?'selected':'' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="fg">
        <label>Student</label>
        <select name="student_id">
          <option value="">All Students</option>
          <% students.forEach(s => { %>
            <option value="<%= s.user_id %>" <%= filters.student_id===s.user_id?'selected':'' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div style="display:flex;gap:8px;align-items:flex-end;">
        <button type="submit" class="btn">Filter</button>
        <a href="/instructor/attendance" class="btn btn-outline">Reset</a>
      </div>
    </div>
  </form>

  <div class="grid-2-asym">
    <!-- Mark Attendance Form -->
    <div class="card">
      <h3>Mark Attendance</h3>
      <% if (error)   { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

      <form method="POST" action="/instructor/attendance">
        <div class="form-group">
          <label>Student *</label>
          <select name="student_id" required>
            <option value="">— Select Student —</option>
            <% students.forEach(s => { %>
              <option value="<%= s.user_id %>"><%= s.name %> (<%= s.section||'' %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Week Number *</label>
          <select name="week_number" required>
            <option value="">— Select Week —</option>
            <% for(let w=1;w<=16;w++){ %>
              <option value="<%= w %>">Week <%= w %></option>
            <% } %>
          </select>
        </div>
        <div class="form-group">
          <label>Date *</label>
          <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" required>
        </div>
        <div class="form-group">
          <label>Status *</label>
          <select name="status" required>
            <option value="">— Select Status —</option>
            <option value="present">Present</option>
            <option value="absent">Absent</option>
            <option value="excused">Excused</option>
          </select>
        </div>
        <button type="submit" class="btn btn-full">Save Attendance</button>
      </form>
    </div>

    <!-- Summary Table -->
    <div class="card">
      <h3>Attendance Summary</h3>
      <% if (students.length > 0) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Student</th><th>Section</th><th>Attended</th><th>Rate</th><th>Status</th></tr></thead>
          <tbody>
            <% students.forEach(s => { %>
            <% const recs = attByStudent[s.user_id] || []; %>
            <% const attended = recs.filter(r=>['present','excused'].includes(r.status)).length; %>
            <% const pct = Math.round((attended/16)*100); %>
            <tr>
              <td><strong><%= s.name %></strong></td>
              <td><%= s.section||'—' %></td>
              <td><%= attended %>/16</td>
              <td>
                <div class="bar-bg" style="min-width:70px;">
                  <div class="bar-fill <%= pct<75?'danger':'' %>" style="width:<%= pct %>%"></div>
                </div>
                <small><%= pct %>%</small>
              </td>
              <td>
                <% if(pct<75){ %><span class="flag">⚠ Below 75%</span>
                <% }else{ %><span style="color:#2e7d32;font-size:.78rem;font-weight:600;">✔ OK</span><% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
        <div class="empty-state">No students found.</div>
      <% } %>
    </div>
  </div>

  <!-- Detailed Records -->
  <% if (filters.student_id && attendance.length > 0) { %>
  <div class="card">
    <h3>Detailed Records</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Week</th><th>Date</th><th>Status</th></tr></thead>
        <tbody>
          <% attendance.forEach(r => { %>
          <tr>
            <td>Week <%= r.week_number %></td>
            <td><%= new Date(r.date).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></td>
            <td><span class="badge badge-<%= r.status %>"><%= r.status.charAt(0).toUpperCase()+r.status.slice(1) %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
