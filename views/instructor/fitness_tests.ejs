<%- include('../partials/header', { title: 'Fitness Test Records' }) %>
<div class="container">
  <a href="/instructor/dashboard" class="back-link">← Back to Dashboard</a>
  <div class="page-title">Fitness Test Records</div>
  <div class="page-sub">View fitness test results submitted by students. Students enter their own scores.</div>

  <!-- Student search filter -->
  <form method="GET" action="/instructor/fitness-tests" id="filterForm">
    <div class="filter-bar">
      <div class="fg" style="flex:1;min-width:220px;">
        <label>Search Student</label>
        <input type="hidden" name="student_id" id="filterStudentId" value="<%= selectedStudentId %>">
        <div class="student-search-wrap">
          <input type="text" id="filterStudentSearch" placeholder="Type a name to search…"
                 autocomplete="off"
                 value="<%= selectedStudent ? selectedStudent.name : '' %>">
          <div class="student-dropdown" id="filterDropdown"></div>
        </div>
      </div>
      <div style="display:flex;gap:8px;align-items:flex-end;">
        <button type="submit" class="btn">View Records</button>
        <a href="/instructor/fitness-tests" class="btn btn-outline">Reset</a>
      </div>
    </div>
  </form>

  <% if (error)   { %><div class="alert alert-error"  style="margin-bottom:16px;"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success" style="margin-bottom:16px;"><%= success %></div><% } %>

  <% if (selectedStudent) { %>
  <!-- Student info banner -->
  <div style="background:rgba(255,255,255,.92);border-radius:12px;padding:18px 24px;margin-bottom:20px;display:flex;align-items:center;gap:20px;box-shadow:0 4px 20px rgba(4,44,83,.12);border:1px solid rgba(255,255,255,.5);">
    <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#042C53,#185FA5);display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0;">👤</div>
    <div>
      <div style="font-size:1.05rem;font-weight:700;color:#042C53;"><%= selectedStudent.name %></div>
      <div style="font-size:.82rem;color:#666;margin-top:3px;">
        <%= selectedStudent.student_id || '—' %> &bull;
        Section <%= selectedStudent.section || '—' %> &bull;
        <%= selectedStudent.course || '—' %> &bull;
        <%= selectedStudent.gender ? selectedStudent.gender.charAt(0).toUpperCase()+selectedStudent.gender.slice(1) : '—' %> &bull;
        PATHFit <%= selectedStudent.pathfit_level || '—' %>
      </div>
    </div>
    <div style="margin-left:auto;text-align:right;">
      <div style="font-size:1.6rem;font-weight:800;color:#042C53;"><%= tests.length %></div>
      <div style="font-size:.75rem;color:#888;text-transform:uppercase;letter-spacing:.6px;">Tests Recorded</div>
    </div>
  </div>
  <% } %>

  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid #e8ecf0;">
      <h3 style="margin:0;border:none;padding:0;">
        <% if (selectedStudent) { %>
          <%= selectedStudent.name %>'s Test Results
        <% } else { %>
          All Student Test Records
        <% } %>
      </h3>
      <% if (!selectedStudentId) { %>
        <span style="font-size:.78rem;color:#888;background:#f0f4f8;padding:4px 10px;border-radius:20px;">
          <%= tests.length %> total records
        </span>
      <% } else { %>
        <div style="display:flex;gap:12px;font-size:.8rem;">
          <span style="color:#6a1b9a;font-weight:600;">Pre: <%= tests.filter(t=>t.test_period==='pre').length %></span>
          <span style="color:#00695c;font-weight:600;">Post: <%= tests.filter(t=>t.test_period==='post').length %></span>
        </div>
      <% } %>
    </div>

    <% if (tests.length > 0) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <% if (!selectedStudentId) { %><th>Student</th><% } %>
            <th>Test</th>
            <th>Period</th>
            <th>Score</th>
            <th>Rating</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% const labels = {push_ups:'Push-Ups',sit_reach:'Sit & Reach (cm)',zipper_test:'Zipper Test (cm)',juggling:'Juggling',sprint_40m:'40 Meter Sprint (sec)',stork_balance:'Stork Balance Test (Seconds)',stick_drop:'Stick Drop Test (cm)',agility_test:'Agility Test (Seconds)',step_test_3min:'Cardio Endurance — 3-Min Step Test'}; %>
          <% tests.forEach(t => { %>
          <tr>
            <% if (!selectedStudentId) { %>
            <td><strong><%= t.users ? t.users.name : '—' %></strong></td>
            <% } %>
            <td><strong><%= labels[t.test_type]||t.test_type %></strong></td>
            <td><span class="badge badge-<%= t.test_period %>"><%= t.test_period.charAt(0).toUpperCase()+t.test_period.slice(1) %></span></td>
            <td><%= t.reps_or_cm %></td>
            <td>
              <% if(t.rating){ %>
                <span class="badge badge-<%= t.rating %>"><%= t.rating.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase()) %></span>
              <% }else{ %>—<% } %>
            </td>
            <td><%= new Date(t.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <div class="empty-state">
        <% if (selectedStudentId) { %>
          No fitness tests recorded for this student yet.
        <% } else { %>
          No fitness test records found. Students will appear here once they submit their results.
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Info notice -->
  <div style="background:rgba(255,255,255,.7);border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:12px;font-size:.85rem;color:#555;border:1px solid rgba(255,255,255,.4);">
    <span style="font-size:1.3rem;">ℹ️</span>
    <span>Students record their own fitness test scores from their <strong>My Tests</strong> page. Ratings are automatically calculated based on gender-specific rubrics.</span>
  </div>
</div>

<script>
const ALL_STUDENTS = <%- JSON.stringify(students.map(s => ({
  id: s.user_id,
  name: s.name,
  section: s.section || ''
}))) %>;

function buildStudentSearch(inputId, dropId, hiddenId) {
  const input  = document.getElementById(inputId);
  const drop   = document.getElementById(dropId);
  const hidden = document.getElementById(hiddenId);
  if (!input || !drop || !hidden) return;
  let activeIdx = -1;

  function renderItems(list) {
    drop.innerHTML = ''; activeIdx = -1;
    if (!list.length) {
      drop.innerHTML = '<div class="sd-empty">No students found</div>';
    } else {
      list.forEach(s => {
        const div = document.createElement('div');
        div.className = 'sd-item';
        div.dataset.id = s.id; div.dataset.name = s.name;
        div.innerHTML = `<span>${s.name}</span>${s.section?`<span class="sd-section">${s.section}</span>`:''}`;
        div.addEventListener('mousedown', e => { e.preventDefault(); selectStudent(s); });
        drop.appendChild(div);
      });
    }
    drop.style.display = 'block';
  }

  function selectStudent(s) {
    input.value = s.name; hidden.value = s.id;
    drop.style.display = 'none'; activeIdx = -1;
  }

  function filter(q) {
    const lq = q.trim().toLowerCase();
    return lq ? ALL_STUDENTS.filter(s => s.name.toLowerCase().includes(lq) || s.section.toLowerCase().includes(lq)) : ALL_STUDENTS;
  }

  input.addEventListener('input',  () => { hidden.value = ''; renderItems(filter(input.value)); });
  input.addEventListener('focus',  () => renderItems(filter(input.value)));
  input.addEventListener('blur',   () => setTimeout(() => { drop.style.display = 'none'; }, 150));
  input.addEventListener('keydown', e => {
    const items = drop.querySelectorAll('.sd-item');
    if (!items.length) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx+1, items.length-1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx-1, 0); }
    else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); const it=items[activeIdx]; selectStudent({id:it.dataset.id,name:it.dataset.name}); return; }
    else if (e.key === 'Escape') { drop.style.display='none'; return; }
    items.forEach((el,i) => el.classList.toggle('active', i===activeIdx));
    if (activeIdx >= 0) items[activeIdx].scrollIntoView({block:'nearest'});
  });
}

buildStudentSearch('filterStudentSearch', 'filterDropdown', 'filterStudentId');
</script>

<style>
.student-dropdown { position:absolute; top:calc(100% + 4px); left:0; right:0; background:#fff; border:1px solid #cdd5e0; border-radius:6px; max-height:220px; overflow-y:auto; z-index:999; box-shadow:0 4px 12px rgba(0,0,0,.12); display:none; }
.student-dropdown .sd-item { padding:9px 14px; cursor:pointer; font-size:.88rem; border-bottom:1px solid #f0f0f0; display:flex; justify-content:space-between; align-items:center; }
.student-dropdown .sd-item:last-child { border-bottom:none; }
.student-dropdown .sd-item:hover, .student-dropdown .sd-item.active { background:#eef3fb; }
.student-dropdown .sd-section { font-size:.75rem; color:#888; background:#f0f4fa; padding:2px 7px; border-radius:10px; }
.student-dropdown .sd-empty { padding:10px 14px; color:#999; font-size:.85rem; font-style:italic; }
</style>

<%- include('../partials/footer') %>
