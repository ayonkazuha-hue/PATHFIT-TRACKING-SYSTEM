<%- include('../partials/header', { title: 'Modules' }) %>
<div class="container">
  <a href="/instructor/dashboard" class="back-link">← Back to Dashboard</a>
  <div class="page-title">15-Week Modules</div>
  <div class="page-sub">CHED-aligned PATHFit curriculum. Click "Edit" on any card to update.</div>

  <% if (error)   { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

  <div class="level-tabs">
    <a href="/instructor/lesson-plans?level=1" class="level-tab <%= level===1?'active':'' %>">PATHFit 1</a>
    <a href="/instructor/lesson-plans?level=2" class="level-tab <%= level===2?'active':'' %>">PATHFit 2</a>
  </div>

  <div class="week-grid">
    <% plans.forEach((plan, i) => { %>
    <% const isCurrent = (plan.objectives || '').includes('CURRENT'); %>
    <div class="week-card <%= isCurrent ? 'current' : '' %>" id="card-<%= plan.plan_id %>">
      <div class="week-tag">
        Week <%= plan.week_number %>
        <% if (isCurrent) { %>
          <span class="current-badge">Current Week</span>
        <% } %>
        <% if ((plan.objectives || '').includes('PUBLISHED')) { %>
          <span class="badge" style="background-color: #27ae60; color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; margin-left: <%= isCurrent ? '4px' : '8px' %>;">Visible to Students</span>
        <% } %>
      </div>
      <h4><%= plan.topic %></h4>
      <% if (plan.activity && plan.activity.includes('/modules/')) { %>
        <div style="margin: 10px 0; display: flex; gap: 8px; align-items: center;">
          <a href="<%= plan.activity %>" target="_blank" class="btn btn-sm btn-outline" style="background-color: #f0f4f8; border-color: #d1d9e0;">📄 View / Download Module</a>
          <form method="POST" action="/instructor/lesson-plans/remove-file" style="display:inline;" onsubmit="return confirm('Are you sure you want to remove this module file?');">
            <input type="hidden" name="plan_id" value="<%= plan.plan_id %>">
            <input type="hidden" name="level" value="<%= level %>">
            <button type="submit" class="btn btn-sm" style="background-color: #e74c3c; color: white; border: none; padding: 4.5px 8px;" title="Remove File">🗑 Remove</button>
          </form>
        </div>
      <% } else { %>
        <p style="font-style:italic;color:#777;font-size:.8rem;">No module uploaded yet.</p>
      <% } %>
      <div style="margin-top: 10px; display: flex; gap: 8px;">
        <button class="btn btn-sm btn-outline" onclick="toggleEdit('<%= plan.plan_id %>')">✏ Edit</button>
        <form method="POST" action="/instructor/lesson-plans/toggle-publish" style="display:inline;">
          <input type="hidden" name="plan_id" value="<%= plan.plan_id %>">
          <input type="hidden" name="level" value="<%= level %>">
          <% const isPublished = (plan.objectives || '').includes('PUBLISHED'); %>
          <input type="hidden" name="action" value="<%= isPublished ? 'unpublish' : 'publish' %>">
          <button type="submit" class="btn btn-sm" style="background-color: <%= isPublished ? '#27ae60' : '#bdc3c7' %>; color: <%= isPublished ? 'white' : '#333' %>; border: none;" title="Toggle Visibility">
            <%= isPublished ? '👁️ Published' : '🙈 Hidden' %>
          </button>
        </form>
        <% if (!isCurrent) { %>
          <form method="POST" action="/instructor/lesson-plans/set-current" style="display:inline;">
            <input type="hidden" name="plan_id" value="<%= plan.plan_id %>">
            <input type="hidden" name="level" value="<%= level %>">
            <button type="submit" class="btn btn-sm" style="background-color: #3498db; color: white; border: none;" title="Make this the current week">📍 Set as Current</button>
          </form>
        <% } %>
      </div>

      <div id="edit-<%= plan.plan_id %>" style="display:none;margin-top:12px;border-top:1px solid #e8ecf0;padding-top:12px;">
        <form method="POST" action="/instructor/lesson-plans" id="form-<%= plan.plan_id %>">
          <input type="hidden" name="plan_id" value="<%= plan.plan_id %>">
          <input type="hidden" name="level" value="<%= level %>">
          <input type="hidden" name="activity_url" value="" id="activity_url-<%= plan.plan_id %>">
          <div class="form-group">
            <label style="font-size:.78rem;">Topic</label>
            <input type="text" name="topic" value="<%= plan.topic %>" required style="font-size:.82rem;padding:7px 10px;">
          </div>
          <div class="form-group">
            <label style="font-size:.78rem;">Upload Module (PDF, DOCX, etc.)</label>
            <input type="file" name="module_file" accept=".pdf,.doc,.docx,.ppt,.pptx" style="font-size:.82rem;padding:7px 10px;" id="file-<%= plan.plan_id %>">
            <small style="color:#666; display:block; margin-top:4px;">Uploading a new file will replace the current module.</small>
            <div id="upload-status-<%= plan.plan_id %>" style="margin-top:8px; display:none;"></div>
          </div>
          <button type="submit" class="btn btn-sm">Save Changes</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<script>
function toggleEdit(id) {
  const el = document.getElementById('edit-' + id);
  el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

document.querySelectorAll('[id^="form-"]').forEach(form => {
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const planId = form.querySelector('[name="plan_id"]').value;
    const level = form.querySelector('[name="level"]').value;
    const fileInput = document.getElementById('file-' + planId);
    const statusDiv = document.getElementById('upload-status-' + planId);
    const activityUrlInput = document.getElementById('activity_url-' + planId);
    
    // If no file selected, just submit the form normally
    if (!fileInput.files.length) {
      form.submit();
      return;
    }
    
    const file = fileInput.files[0];
    statusDiv.style.display = 'block';
    statusDiv.innerHTML = '<span style="color: #3498db;">📤 Uploading...</span>';
    
    try {
      // Step 1: Get signed upload URL from backend
      const uploadUrlResponse = await fetch('/instructor/lesson-plans/get-upload-url', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filename: file.name })
      });
      
      if (!uploadUrlResponse.ok) {
        throw new Error(await uploadUrlResponse.text());
      }
      
      const { signedUrl, publicUrl } = await uploadUrlResponse.json();
      
      // Step 2: Upload file directly to Supabase using signed URL
      const uploadResponse = await fetch(signedUrl, {
        method: 'PUT',
        body: file,
        headers: { 'Content-Type': file.type }
      });
      
      if (!uploadResponse.ok) {
        throw new Error(`Upload failed: ${uploadResponse.statusText}`);
      }
      
      // Step 3: Set the public URL and submit form
      activityUrlInput.value = publicUrl;
      statusDiv.innerHTML = '<span style="color: #27ae60;">✅ Upload complete! Saving...</span>';
      
      // Small delay to show completion message
      setTimeout(() => form.submit(), 500);
      
    } catch (err) {
      console.error('Upload error:', err);
      statusDiv.innerHTML = '<span style="color: #e74c3c;">❌ Upload failed: ' + err.message + '</span>';
    }
  });
});
</script>
<%- include('../partials/footer') %>
