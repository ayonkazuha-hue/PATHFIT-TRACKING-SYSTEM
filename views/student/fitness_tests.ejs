<%- include('../partials/header', { title: 'My Fitness Tests' }) %>

<style>
.pdf-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 9px 18px; background: #e53935; color: #fff;
  border: none; border-radius: 7px; font-size: .88rem; font-weight: 700;
  cursor: pointer; text-decoration: none; transition: background .2s, opacity .2s;
}
.pdf-btn:hover    { background: #b71c1c; }
.pdf-btn:disabled { opacity: .6; cursor: not-allowed; }

/* ── Rating preview chip */
.rating-preview {
  display: none; margin-top: 10px; padding: 10px 14px;
  border-radius: 8px; font-size: .88rem; font-weight: 600;
  border: 1.5px solid; align-items: center; gap: 8px;
}
.rating-preview.show { display: flex; }
.rating-excellent        { background:#e8f5e9; color:#2e7d32; border-color:#a5d6a7; }
.rating-good             { background:#e3f2fd; color:#1565c0; border-color:#90caf9; }
.rating-fair             { background:#fff3e0; color:#e65100; border-color:#ffcc80; }
.rating-needs_improvement{ background:#ffebee; color:#c62828; border-color:#ef9a9a; }
</style>

<!-- jsPDF + AutoTable -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<div class="container">
  <a href="/student/dashboard" class="back-link">← Back to Dashboard</a>
  <div class="page-title">My Fitness Tests</div>
  <div class="page-sub">Record your fitness test scores and view your history.</div>

  <div class="grid-2-asym">

    <!-- ── Entry Form ── -->
    <div class="card">
      <h3>Record New Test</h3>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form method="POST" action="/student/fitness-tests" id="testForm">
        <div class="form-group">
          <label>Test Type *</label>
          <select name="test_type" id="testType" required onchange="onTestTypeChange()">
            <option value="">— Select Test —</option>
            <option value="push_ups">Push-Ups (reps)</option>
            <option value="sit_reach">Sit & Reach (cm)</option>
            <option value="zipper_test">Zipper Test (bpm)</option>
            <option value="juggling">Juggling (reps)</option>
            <option value="sprint_40m">40 Meter Sprint (seconds)</option>
            <option value="step_test_3min">Cardiovascular Endurance — 3-Min Step Test</option>
          </select>
        </div>

        <div class="form-group">
          <label>Test Period *</label>
          <select name="test_period" required>
            <option value="">— Select Period —</option>
            <option value="pre">Pre-Test</option>
            <option value="post">Post-Test</option>
          </select>
        </div>

        <!-- Standard score field (hidden for step test) -->
        <div class="form-group" id="scoreGroup">
          <label id="scoreLabel">Your Score *</label>
          <input type="number" name="reps_or_cm" id="scoreInput"
                 step="0.01" min="0" placeholder="e.g. 25"
                 oninput="previewRating()">
          <div class="rating-preview" id="ratingPreview"></div>
        </div>

        <!-- Step Test HR fields (shown only for step_test_3min) -->
        <div id="stepFormFields" style="display:none;">
          <div class="form-group">
            <label>Heart Rate Before Activity * <span style="font-size:.78rem;color:#888;">(bpm)</span></label>
            <input type="number" id="formHrBefore" name="hr_before" min="40" max="220" placeholder="e.g. 72" step="1">
          </div>
          <div class="form-group">
            <label>Heart Rate After Activity * <span style="font-size:.78rem;color:#888;">(bpm — used for rating)</span></label>
            <input type="number" id="formHrAfter" name="reps_or_cm_step" min="40" max="220" placeholder="e.g. 120" step="1" oninput="previewStepRating()">
            <div class="rating-preview" id="stepRatingPreview"></div>
          </div>
        </div>

        <button type="submit" class="btn btn-full" id="submitBtn" onclick="return prepareStepSubmit()">Save My Test Result</button>
      </form>

      <!-- Rubric reference -->
      <div style="margin-top:20px;padding:14px;background:#f5f8fc;border-radius:8px;font-size:.8rem;">
        <strong style="color:#042C53;display:block;margin-bottom:8px;">📋 Rating Reference</strong>
        <div id="rubricRef" style="color:#555;line-height:1.8;">
          Select a test type above to see the rating guide.
        </div>
      </div>
    </div>

    <!-- ── Test History ── -->
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid #e8ecf0;">
        <h3 style="margin:0;border:none;padding:0;">Test History</h3>
        <% if (tests.length > 0) { %>
        <button class="pdf-btn" id="pdfBtn" onclick="downloadPDF()">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download PDF
        </button>
        <% } %>
      </div>

      <% if (tests.length > 0) { %>
      <div class="table-wrap">
        <table id="tests-table">
          <thead>
            <tr><th>#</th><th>Test</th><th>Period</th><th>Score</th><th>Rating</th><th>Date</th></tr>
          </thead>
          <tbody>
            <% const labels = {
                 push_ups:       'Push-Ups',
                 sit_reach:      'Sit & Reach (cm)',
                 zipper_test:    'Zipper Test (bpm)',
                 juggling:       'Juggling',
                 sprint_40m:     '40 Meter Sprint (sec)',
                 step_test_3min: 'Cardio Endurance — 3-Min Step Test'
               }; %>
            <% tests.forEach((t, i) => { %>
            <tr>
              <td style="color:#999;font-size:.8rem;"><%= i+1 %></td>
              <td><strong><%= labels[t.test_type]||t.test_type %></strong></td>
              <td><span class="badge badge-<%= t.test_period %>"><%= t.test_period.charAt(0).toUpperCase()+t.test_period.slice(1) %></span></td>
              <td>
                <% if (t.test_type === 'step_test_3min') { %>
                  <% if (t.hr_before) { %>
                    <span style="font-size:.78rem;color:#666;">Before:</span> <strong><%= t.hr_before %></strong> bpm<br>
                    <span style="font-size:.78rem;color:#666;">After:</span> <strong><%= t.reps_or_cm %></strong> bpm
                  <% } else { %>
                    <strong><%= t.reps_or_cm %></strong> bpm (after)
                  <% } %>
                <% } else { %>
                  <%= t.reps_or_cm %>
                <% } %>
              </td>
              <td>
                <% if(t.rating){ %>
                  <span class="badge badge-<%= t.rating %>"><%= t.rating.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase()) %></span>
                <% }else{ %>—<% } %>
              </td>
              <td><%= new Date(t.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div style="display:flex;gap:20px;flex-wrap:wrap;margin-top:16px;padding-top:14px;border-top:1px solid #e8ecf0;">
        <div style="font-size:.8rem;color:#555;"><strong style="color:#042C53;">Total:</strong> <%= tests.length %></div>
        <div style="font-size:.8rem;color:#555;"><strong style="color:#042C53;">Pre-Tests:</strong> <%= tests.filter(t=>t.test_period==='pre').length %></div>
        <div style="font-size:.8rem;color:#555;"><strong style="color:#042C53;">Post-Tests:</strong> <%= tests.filter(t=>t.test_period==='post').length %></div>
      </div>

      <% } else { %>
        <div class="empty-state">No tests recorded yet. Use the form on the left to add your first result.</div>
      <% } %>
    </div>

  </div><!-- end grid -->

  <div style="margin-top:8px;">
    <a href="/student/report" class="btn">View Pre/Post Comparison →</a>
  </div>
</div>

<!-- Embed data for JS -->
<script>
const STUDENT_GENDER = '<%= gender %>';

/* ── Rubric data (mirrors server-side getRating) ── */
const RUBRICS = {
  push_ups: {
    // Male:   ≥30 Excellent, 20-29 Very Good, 10-19 Good, 5-9 Fair, 1-4 Needs Improvement, 0 Poor
    // Female: ≥20 Excellent, 15-19 Very Good, 10-14 Good, 5-9 Fair, 1-4 Needs Improvement, 0 Poor
    male:   [[30,'excellent'],[20,'good'],[10,'fair'],[5,'needs_improvement'],[1,'needs_improvement'],[0,'needs_improvement']],
    female: [[20,'excellent'],[15,'good'],[10,'fair'],[5,'needs_improvement'],[1,'needs_improvement'],[0,'needs_improvement']],
  },
  sit_reach: {
    male:   [[27,'excellent'],[17,'good'],[6,'fair'],[0,'needs_improvement']],
    female: [[30,'excellent'],[21,'good'],[11,'fair'],[0,'needs_improvement']],
  },
  zipper_test: {
    male:   [[0,'excellent'],[80,'good'],[90,'fair'],[100,'needs_improvement']],
    female: [[0,'excellent'],[85,'good'],[95,'fair'],[105,'needs_improvement']],
    lowerIsBetter: true,
  },
  juggling: {
    male:   [[36,'excellent'],[29,'good'],[22,'fair'],[0,'needs_improvement']],
    female: [[20,'excellent'],[15,'good'],[10,'fair'],[0,'needs_improvement']],
  },
  sprint_40m: {
    male:   [[0,'excellent'],[6.0,'good'],[7.0,'fair'],[8.0,'needs_improvement']],
    female: [[0,'excellent'],[7.0,'good'],[8.0,'fair'],[9.0,'needs_improvement']],
    lowerIsBetter: true,
  },
};

const RUBRIC_LABELS = {
  push_ups:    { unit:'reps', male:  ['≥ 30','20–29','10–19','5–9','1–4','0'],   female: ['≥ 20','15–19','10–14','5–9','1–4','0'] },
  sit_reach:   { unit:'cm',   male:  ['≥ 27','17–26','6–16','< 6'],     female: ['≥ 30','21–29','11–20','< 11'] },
  zipper_test: { unit:'bpm',  male:  ['< 80','80–89','90–99','≥ 100'],  female: ['< 85','85–94','95–104','≥ 105'] },
  juggling:    { unit:'reps', male:  ['≥ 36','29–35','22–28','< 22'],   female: ['≥ 20','15–19','10–14','< 10'] },
  sprint_40m:  { unit:'sec',  male:  ['< 6','6–6.9','7–7.9','≥ 8'],    female: ['< 7','7–7.9','8–8.9','≥ 9'] },
};

const RATING_NAMES  = ['Excellent','Very Good','Good','Fair','Needs Improvement','Poor'];
const RATING_KEYS   = ['excellent','good','fair','needs_improvement'];
const RATING_COLORS_CSS = {
  excellent:         'rating-excellent',
  good:              'rating-good',
  fair:              'rating-fair',
  needs_improvement: 'rating-needs_improvement',
};

function updateRubricRef(testType) {
  const el = document.getElementById('rubricRef');
  if (testType === 'push_ups') {
    const g = STUDENT_GENDER || 'male';
    const arr = RUBRIC_LABELS.push_ups[g];
    const names  = ['Excellent','Very Good','Good','Fair','Needs Improvement','Poor'];
    const colors = ['#2e7d32','#1565c0','#388e3c','#e65100','#c62828','#4a148c'];
    el.innerHTML = names.map((name, i) =>
      `<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #e8ecf0;">
         <span style="color:${colors[i]};font-weight:600;">${name}</span>
         <span>${arr[i]} reps</span>
       </div>`
    ).join('');
    return;
  }
  if (!testType || !RUBRIC_LABELS[testType]) {
    el.innerHTML = 'Select a test type above to see the rating guide.';
    return;
  }
  const r   = RUBRIC_LABELS[testType];
  const g   = STUDENT_GENDER || 'male';
  const arr = r[g] || r['male'];
  const stdNames  = ['Excellent','Good','Fair','Needs Improvement'];
  const colors = ['#2e7d32','#1565c0','#e65100','#c62828'];
  el.innerHTML = stdNames.map((name, i) =>
    `<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #e8ecf0;">
       <span style="color:${colors[i]};font-weight:600;">${name}</span>
       <span>${arr[i]} ${r.unit}</span>
     </div>`
  ).join('');
}

function getRating(testType, gender, value) {
  const v = parseFloat(value);
  if (isNaN(v)) return null;
  const rubric = RUBRICS[testType];
  if (!rubric) return null;
  const table = rubric[gender] || rubric['male'];
  if (rubric.lowerIsBetter) {
    const rev = [...table].reverse();
    for (const [threshold, rating] of rev) {
      if (v >= threshold) return rating;
    }
    return 'excellent';
  }
  for (const [threshold, rating] of table) {
    if (v >= threshold) return rating;
  }
  return 'needs_improvement';
}

function previewRating() {
  const testType = document.getElementById('testType').value;
  const score    = document.getElementById('scoreInput').value;
  const preview  = document.getElementById('ratingPreview');

  updateRubricRef(testType);

  if (!testType || !score) { preview.className = 'rating-preview'; return; }
  const rating = getRating(testType, STUDENT_GENDER, score);
  if (!rating) { preview.className = 'rating-preview'; return; }

  const ratingLabels = { excellent:'Excellent ⭐', good:'Good 👍', fair:'Fair 📊', needs_improvement:'Needs Improvement 💪' };
  preview.textContent = 'Estimated Rating: ' + (ratingLabels[rating] || rating);
  preview.className   = 'rating-preview show ' + RATING_COLORS_CSS[rating];
}

function updateRubricRef(testType) {
  const el = document.getElementById('rubricRef');
  if (testType === 'push_ups') {
    const g = STUDENT_GENDER || 'male';
    const arr = RUBRIC_LABELS.push_ups[g];
    const names  = ['Excellent','Very Good','Good','Fair','Needs Improvement','Poor'];
    const colors = ['#2e7d32','#1565c0','#388e3c','#e65100','#c62828','#4a148c'];
    el.innerHTML = names.map((name, i) =>
      `<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #e8ecf0;">
         <span style="color:${colors[i]};font-weight:600;">${name}</span>
         <span>${arr[i]} reps</span>
       </div>`
    ).join('');
    return;
  }
  if (!testType || !RUBRIC_LABELS[testType]) {
    el.innerHTML = 'Select a test type above to see the rating guide.';
    return;
  }
  const r   = RUBRIC_LABELS[testType];
  const g   = STUDENT_GENDER || 'male';
  const arr = r[g] || r['male'];
  const stdNames  = ['Excellent','Good','Fair','Needs Improvement'];
  const colors = ['#2e7d32','#1565c0','#e65100','#c62828'];
  el.innerHTML = stdNames.map((name, i) =>
    `<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #e8ecf0;">
       <span style="color:${colors[i]};font-weight:600;">${name}</span>
       <span>${arr[i]} ${r.unit}</span>
     </div>`
  ).join('');
}

/* ── Step Test (3-Min) specific functions ── */
function getStepRating(gender, hrAfter) {
  const v = parseFloat(hrAfter);
  if (isNaN(v)) return null;
  if (gender === 'female') {
    if (v <= 81)  return { key:'excellent',        label:'Excellent ⭐',         css:'rating-excellent' };
    if (v <= 102) return { key:'good',             label:'Very Good 👍',         css:'rating-good' };
    if (v <= 110) return { key:'fair',             label:'Good 📊',              css:'rating-fair' };
    if (v <= 120) return { key:'needs_improvement',label:'Fair 💪',              css:'rating-needs_improvement' };
    return                { key:'needs_improvement',label:'Needs Improvement ⚠️', css:'rating-needs_improvement' };
  } else {
    if (v <= 76)  return { key:'excellent',        label:'Excellent ⭐',         css:'rating-excellent' };
    if (v <= 93)  return { key:'good',             label:'Very Good 👍',         css:'rating-good' };
    if (v <= 100) return { key:'fair',             label:'Good 📊',              css:'rating-fair' };
    if (v <= 107) return { key:'needs_improvement',label:'Fair 💪',              css:'rating-needs_improvement' };
    return                { key:'needs_improvement',label:'Needs Improvement ⚠️', css:'rating-needs_improvement' };
  }
}

function updateStepTestPreview() {
  const hrAfter  = document.getElementById('hrAfterInput').value;
  const preview  = document.getElementById('stepTestPreview');
  if (!hrAfter) { preview.style.display = 'none'; return; }
  const result = getStepRating(STUDENT_GENDER, hrAfter);
  if (!result) { preview.style.display = 'none'; return; }
  preview.textContent = 'Estimated Rating: ' + result.label;
  preview.className   = result.css;
  preview.style.display = 'block';
}

function previewStepRating() {
  const hrAfter  = document.getElementById('formHrAfter').value;
  const preview  = document.getElementById('stepRatingPreview');
  if (!hrAfter) { preview.className = 'rating-preview'; return; }
  const result = getStepRating(STUDENT_GENDER, hrAfter);
  if (!result) { preview.className = 'rating-preview'; return; }
  preview.textContent = 'Estimated Rating: ' + result.label;
  preview.className   = 'rating-preview show ' + result.css;
}

function useStepTestScore() {
  const hrBefore = document.getElementById('hrBeforeInput').value;
  const hrAfter  = document.getElementById('hrAfterInput').value;
  if (!hrBefore || !hrAfter) { alert('Please enter both HR Before and HR After values.'); return; }
  // Sync to form
  const testTypeSelect = document.getElementById('testType');
  testTypeSelect.value = 'step_test_3min';
  testTypeSelect.dispatchEvent(new Event('change'));
  document.getElementById('formHrBefore').value = hrBefore;
  document.getElementById('formHrAfter').value  = hrAfter;
  previewStepRating();
  document.getElementById('testForm').scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function onTestTypeChange() {
  const type = document.getElementById('testType').value;
  const isStep = type === 'step_test_3min';
  // Toggle standard score vs step test fields
  document.getElementById('scoreGroup').style.display     = isStep ? 'none' : '';
  document.getElementById('stepFormFields').style.display = isStep ? '' : 'none';
  // Toggle required attributes
  const scoreInput = document.getElementById('scoreInput');
  scoreInput.required = !isStep;
  if (isStep) scoreInput.value = '';
  // Update rubric ref
  if (!isStep) {
    previewRating();
  } else {
    document.getElementById('rubricRef').innerHTML =
      'Heart Rate After Activity is used for rating. See the reference table in the form below.';
    document.getElementById('ratingPreview').className = 'rating-preview';
  }
}

function prepareStepSubmit() {
  const type = document.getElementById('testType').value;
  if (type !== 'step_test_3min') return true; // normal submit
  const hrBefore = document.getElementById('formHrBefore').value;
  const hrAfter  = document.getElementById('formHrAfter').value;
  if (!hrBefore || !hrAfter) {
    alert('Please enter both Heart Rate Before and Heart Rate After values.');
    return false;
  }
  // Copy hrAfter into the reps_or_cm field (that's what the server reads for rating)
  document.getElementById('scoreInput').value = hrAfter;
  document.getElementById('scoreInput').removeAttribute('required');
  return true;
}

/* ── PDF generation (same as before) ── */
const TEST_DATA = <%- JSON.stringify(tests.map((t, i) => ({
  num:    i + 1,
  type:   { push_ups:'Push-Ups', sit_reach:'Sit & Reach (cm)', zipper_test:'Zipper Test (bpm)', juggling:'Juggling', sprint_40m:'40 Meter Sprint (sec)', step_test_3min:'Cardio Endurance — 3-Min Step Test' }[t.test_type] || t.test_type,
  period: t.test_period.charAt(0).toUpperCase() + t.test_period.slice(1),
  score:  t.test_type === 'step_test_3min'
    ? (t.hr_before ? 'Before: ' + t.hr_before + ' / After: ' + t.reps_or_cm + ' bpm' : 'After: ' + t.reps_or_cm + ' bpm')
    : String(t.reps_or_cm),
  rating: t.rating ? t.rating.replace(/_/g,' ').replace(/\b\w/g, c => c.toUpperCase()) : '—',
  date:   new Date(t.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}),
  ratingKey: t.rating || '',
  periodKey: t.test_period || ''
}))) %>;

const RATING_COLORS = { excellent:[46,125,50], good:[21,101,192], fair:[230,81,0], needs_improvement:[198,40,40] };
const PERIOD_COLORS = { pre:[106,27,154], post:[0,105,92] };

function downloadPDF() {
  const btn = document.getElementById('pdfBtn');
  btn.disabled = true;
  btn.innerHTML = '⏳ Generating…';
  try {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation:'portrait', unit:'mm', format:'a4' });
    const pageW = doc.internal.pageSize.getWidth();
    const margin = 15;
    const now = new Date();

    doc.setFillColor(4,44,83); doc.rect(0,0,pageW,28,'F');
    doc.setTextColor(255,255,255); doc.setFontSize(15); doc.setFont('helvetica','bold');
    doc.text('PATHFIT Tracking System', margin, 11);
    doc.setFontSize(8); doc.setFont('helvetica','normal');
    doc.text('Physical Activity Towards Health and Fitness — NBSC', margin, 17);
    doc.setFontSize(7.5);
    doc.text('Generated: ' + now.toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'}), pageW-margin, 17, {align:'right'});

    doc.setTextColor(4,44,83); doc.setFontSize(13); doc.setFont('helvetica','bold');
    doc.text('My Fitness Test Results', margin, 38);
    doc.setDrawColor(24,95,165); doc.setLineWidth(0.8); doc.line(margin,41,margin+70,41);

    const preCount  = TEST_DATA.filter(r=>r.periodKey==='pre').length;
    const postCount = TEST_DATA.filter(r=>r.periodKey==='post').length;
    let cx = margin;
    [{label:'Total Records',value:String(TEST_DATA.length)},{label:'Pre-Tests',value:String(preCount)},{label:'Post-Tests',value:String(postCount)}].forEach(chip=>{
      doc.setFillColor(240,244,248); doc.roundedRect(cx,44,42,12,2,2,'F');
      doc.setTextColor(100,100,100); doc.setFontSize(7); doc.setFont('helvetica','normal');
      doc.text(chip.label,cx+21,49,{align:'center'});
      doc.setTextColor(4,44,83); doc.setFontSize(10); doc.setFont('helvetica','bold');
      doc.text(chip.value,cx+21,54,{align:'center'}); cx+=46;
    });

    doc.autoTable({
      startY:60, margin:{left:margin,right:margin},
      head:[['#','Test','Period','Score','Rating','Date']],
      body:TEST_DATA.map(r=>[r.num,r.type,r.period,r.score,r.rating,r.date]),
      headStyles:{fillColor:[4,44,83],textColor:[255,255,255],fontStyle:'bold',fontSize:9,cellPadding:4},
      bodyStyles:{fontSize:9,cellPadding:3.5,textColor:[20,20,20]},
      alternateRowStyles:{fillColor:[245,248,252]},
      columnStyles:{0:{cellWidth:10,halign:'center',textColor:[160,160,160]},2:{cellWidth:22,halign:'center'},3:{cellWidth:20,halign:'center'},4:{cellWidth:36,halign:'center'},5:{cellWidth:32}},
      didDrawCell(data){
        if(data.section!=='body') return;
        const row=TEST_DATA[data.row.index]; if(!row) return;
        if(data.column.index===2){
          const col=PERIOD_COLORS[row.periodKey]||[100,100,100];
          const {x,y,width,height}=data.cell; const text=row.period;
          const bw=doc.getTextWidth(text)+6,bh=5,bx=x+(width-bw)/2,by=y+(height-bh)/2;
          doc.setFillColor(...col); doc.roundedRect(bx,by,bw,bh,1.5,1.5,'F');
          doc.setTextColor(255,255,255); doc.setFontSize(7.5); doc.setFont('helvetica','bold');
          doc.text(text,bx+bw/2,by+3.5,{align:'center'});
        }
        if(data.column.index===4&&row.ratingKey){
          const col=RATING_COLORS[row.ratingKey]||[100,100,100];
          const {x,y,width,height}=data.cell; const text=row.rating;
          const bw=Math.max(doc.getTextWidth(text)+8,28),bh=5,bx=x+(width-bw)/2,by=y+(height-bh)/2;
          doc.setFillColor(...col); doc.roundedRect(bx,by,bw,bh,1.5,1.5,'F');
          doc.setTextColor(255,255,255); doc.setFontSize(7.5); doc.setFont('helvetica','bold');
          doc.text(text,bx+bw/2,by+3.5,{align:'center'});
        }
      },
      didParseCell(data){
        if(data.section==='body'&&(data.column.index===2||data.column.index===4)) data.cell.text=[];
      },
    });

    const pageCount=doc.internal.getNumberOfPages();
    for(let p=1;p<=pageCount;p++){
      doc.setPage(p);
      const footerY=doc.internal.pageSize.getHeight()-8;
      doc.setDrawColor(200,200,200); doc.setLineWidth(0.3); doc.line(margin,footerY-3,pageW-margin,footerY-3);
      doc.setFontSize(7); doc.setFont('helvetica','normal'); doc.setTextColor(160,160,160);
      doc.text('PATHFIT Tracking System — NBSC  |  Confidential',margin,footerY);
      doc.text('Page '+p+' of '+pageCount,pageW-margin,footerY,{align:'right'});
    }
    doc.save('Fitness_Test_Results_'+now.toISOString().slice(0,10)+'.pdf');
  } catch(err) {
    console.error(err); alert('Could not generate PDF. Please try again.');
  } finally {
    btn.disabled=false;
    btn.innerHTML=`<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Download PDF`;
  }
}
</script>

