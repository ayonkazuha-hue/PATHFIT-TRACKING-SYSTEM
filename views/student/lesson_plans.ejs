<%- include('../partials/header', { title: 'Modules' }) %>
<div class="container">
  <a href="/student/dashboard" class="back-link">← Back to Dashboard</a>
  <div class="page-title">15-Week Modules</div>
  <div class="page-sub">CHED-aligned PATHFit curriculum for the full semester.</div>



  <div class="week-grid">
    <% 
      const publishedPlans = plans.filter(p => (p.objectives || '').includes('PUBLISHED'));
      const currentPlanObj = publishedPlans.find(p => (p.objectives || '').includes('CURRENT'));
      const currentPlanId = currentPlanObj ? currentPlanObj.plan_id : null;
    %>
    <% if (publishedPlans.length === 0) { %>
      <div style="text-align:center; padding: 40px; color: #777; background: #fff; border-radius: 8px; border: 1px dashed #ccc;">
        No modules have been published yet.
      </div>
    <% } %>
    <% publishedPlans.forEach((plan) => { %>
    <% const isCurrent = plan.plan_id === currentPlanId; %>
    <div class="week-card <%= isCurrent ? 'current' : '' %>">
      <div class="week-tag">
        Week <%= plan.week_number %>
        <% if (isCurrent) { %><span class="current-badge">Current</span><% } %>
      </div>
      <h4><%= plan.topic %></h4>
      <% if (plan.activity && plan.activity.includes('/modules/')) { %>
        <div style="margin: 15px 0;">
          <a href="/student/view-module?file=<%= encodeURIComponent(plan.activity) %>&title=<%= encodeURIComponent('Week ' + plan.week_number + ': ' + plan.topic) %>" class="btn btn-sm btn-outline" style="background-color: #f0f4f8; border-color: #d1d9e0; text-decoration: none; display: inline-block;">👁️ View Module</a>
        </div>
      <% } else { %>
        <p style="font-style:italic;color:#777;font-size:.8rem;margin-top:10px;">No module uploaded yet.</p>
      <% } %>
    </div>
    <% }) %>
  </div>
</div>
<%- include('../partials/footer') %>
