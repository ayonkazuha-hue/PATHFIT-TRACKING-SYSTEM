<%- include('../partials/header', { title: 'Lesson Plans' }) %>
<div class="container">
  <a href="/student/dashboard" class="back-link">← Back to Dashboard</a>
  <div class="page-title">16-Week Lesson Plans</div>
  <div class="page-sub">CHED-aligned PATHFit curriculum for the full semester.</div>

  <div class="level-tabs">
    <a href="/student/lesson-plans?level=1" class="level-tab <%= level===1?'active':'' %>">PATHFit 1</a>
    <a href="/student/lesson-plans?level=2" class="level-tab <%= level===2?'active':'' %>">PATHFit 2</a>
  </div>

  <div class="week-grid">
    <% 
      const currIdx = plans.findIndex(p => p.objectives === 'CURRENT');
      const currentWeekIndex = currIdx >= 0 ? currIdx : 0;
    %>
    <% plans.forEach((plan, i) => { %>
    <div class="week-card <%= i===currentWeekIndex?'current':'' %>">
      <div class="week-tag">
        Week <%= plan.week_number %>
        <% if(i===currentWeekIndex){ %><span class="current-badge">Current</span><% } %>
      </div>
      <h4><%= plan.topic %></h4>
      <% if (i > currentWeekIndex) { %>
        <p style="font-style:italic;color:#777;font-size:.8rem;margin-top:10px;">🔒 This module is currently locked.</p>
      <% } else if (plan.activity && plan.activity.includes('/uploads/modules/')) { %>
        <div style="margin: 15px 0;">
          <a href="<%= plan.activity %>" target="_blank" class="btn btn-sm btn-outline" style="background-color: #f0f4f8; border-color: #d1d9e0; text-decoration: none; display: inline-block;">📄 Download Module</a>
        </div>
      <% } else { %>
        <p style="font-style:italic;color:#777;font-size:.8rem;margin-top:10px;">No module uploaded yet.</p>
      <% } %>
    </div>
    <% }) %>
  </div>
</div>
<%- include('../partials/footer') %>
