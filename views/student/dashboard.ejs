<%- include('../partials/header', { title: 'Student Dashboard' }) %>
<div class="container">
  <div style="margin-bottom:24px;">
    <h2 class="page-title">Hello, <%= user.name %> 👋</h2>
    <p class="page-sub">Your fitness progress overview for PATHFit <%= level %>.</p>
  </div>

  <!-- Stat Cards -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="label">Fitness Tests</div>
      <div class="value"><%= tests.length %></div>
      <div class="sub"><%= preTests.length %> pre · <%= postTests.length %> post</div>
    </div>
    <div class="stat-card">
      <div class="label">Health Screening</div>
      <div class="value" style="font-size:1rem;margin-top:6px;">
        <% if (screening) { %>
          <% if (screening.cleared) { %>
            <span class="badge" style="background:#2e7d32;">✔ Cleared</span>
          <% } else { %>
            <a href="/health-screening" class="btn btn-sm">Re-submit Health Appraisal</a>
          <% } %>
        <% } else { %>
          <a href="/health-screening" class="btn btn-sm">Complete Now</a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Current Lesson Plan -->
  <% if (currentPlan) { %>
  <div class="lesson-banner">
    <div class="week-tag">Week <%= currentPlan.week_number %> · PATHFit <%= level %></div>
    <h3><%= currentPlan.topic %></h3>
    <% if (currentPlan.activity && currentPlan.activity.includes('/modules/')) { %>
      <div style="margin-top: 12px;">
        <a href="/student/view-module?file=<%= encodeURIComponent(currentPlan.activity) %>&title=<%= encodeURIComponent(currentPlan.topic) %>" class="btn btn-sm btn-outline" style="background-color: rgba(255,255,255,0.2); border-color: rgba(255,255,255,0.4); color: white;">👁️ View Module</a>
      </div>
    <% } else { %>
      <p style="margin-top: 12px; font-style: italic; opacity: .8;">No module uploaded yet.</p>
    <% } %>
  </div>
  <% } %>

  <div style="margin-bottom:24px;">
    <!-- Fitness Tests summary → now links to My Report -->
    <div class="card">
      <h3>Fitness Tests <a href="/student/report" class="btn btn-sm" style="font-size:.78rem;">View Report</a></h3>
      <% if (tests.length > 0) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Test</th><th>Period</th><th>Score</th><th>Rating</th></tr></thead>
          <tbody>
            <% const labels = {push_ups:'Push-Ups',sit_reach:'Sit & Reach (cm)',zipper_test:'Zipper Test',juggling:'Juggling',sprint_40m:'40m Sprint',stork_balance:'Stork Balance Test',stick_drop:'Stick Drop Test',agility_test:'Agility Test',step_test_3min:'3-Min Step Test'}; %>
            <% tests.slice(0,8).forEach(t => { %>
            <tr>
              <td><%= labels[t.test_type]||t.test_type %></td>
              <td><span class="badge badge-<%= t.test_period %>"><%= t.test_period.charAt(0).toUpperCase()+t.test_period.slice(1) %></span></td>
              <td><%= t.reps_or_cm %></td>
              <td><% if(t.rating){ %><span class="badge badge-<%= t.rating %>"><%= t.rating.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase()) %></span><% }else{ %>—<% } %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
        <div class="empty-state">No fitness tests recorded yet. Go to <a href="/student/report" style="color:#185FA5;">My Report</a> to add your results.</div>
      <% } %>
    </div>
  </div>

</div>
<%- include('../partials/footer') %>
