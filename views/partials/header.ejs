<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> — PATHFIT Tracking System</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
  <div class="brand">
    <img src="/images/nbsc_logo.png" alt="NBSC Logo" class="brand-logo">
    <div class="brand-text">
      <h1>PATH-FIT TRACKING AND MONITORING SYSTEM</h1>
      <span>Physical Activity Towards Health and Fitness</span>
    </div>
  </div>
  <% if (user) { %>
  <nav>
    <% if (user.role === 'instructor') { %>
      <a href="/instructor/dashboard">Dashboard</a>
      <a href="/instructor/lesson-plans">Modules</a>
      <a href="/instructor/report">Reports</a>
      <a href="/instructor/health-appraisal" style="position:relative;">
        Health Appraisal Record
        <% if (typeof healthAppraisalNotifications !== 'undefined' && healthAppraisalNotifications.length > 0) { %>
          <span style="position:absolute;top:-6px;right:-10px;background:#e53935;color:#fff;font-size:.6rem;font-weight:700;border-radius:50%;width:16px;height:16px;display:flex;align-items:center;justify-content:center;line-height:1;"><%= healthAppraisalNotifications.length %></span>
        <% } %>
      </a>

      <!-- Notification Bell -->
      <%
        const _pendingRegistrations = (typeof pendingRegistrations !== 'undefined') ? pendingRegistrations : [];
        const _resets   = (typeof pendingPasswordResets      !== 'undefined') ? pendingPasswordResets      : [];
        const _ftNotifs = (typeof fitnessTestNotifications   !== 'undefined') ? fitnessTestNotifications   : [];
        const _haNotifs = (typeof healthAppraisalNotifications !== 'undefined') ? healthAppraisalNotifications : [];
        const _totalNotif = _pendingRegistrations.length + _resets.length + _ftNotifs.length + _haNotifs.length;
      %>
      <div class="notif-wrap">
        <button class="notif-btn" id="notifBtn" aria-label="Notifications">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
          <% if (_totalNotif > 0) { %>
            <span class="notif-badge"><%= _totalNotif %></span>
          <% } %>
        </button>
        <div class="notif-dropdown" id="notifDropdown">
          <div class="notif-header">
            Notifications
            <% if (_totalNotif > 0) { %>
              <span class="notif-count"><%= _totalNotif %> pending</span>
            <% } %>
          </div>

          <% if (_totalNotif === 0) { %>
            <div class="notif-empty">No new notifications</div>
          <% } %>

          <!-- Fitness Test Results -->
          <% if (_ftNotifs.length > 0) { %>
            <%
              const _testLabels = {
                push_ups:'Push-Ups', sit_reach:'Sit & Reach', zipper_test:'Zipper Test',
                juggling:'Juggling', sprint_40m:'40m Sprint', stork_balance:'Stork Balance Test', stick_drop:'Stick Drop Test', agility_test:'Agility Test', step_test_3min:'3-Min Step Test'
              };
            %>
            <div style="padding:6px 14px 4px;font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;color:#aaa;font-weight:700;background:#fafafa;border-bottom:1px solid #f0f4f8;">
              📊 New Test Results
            </div>
            <% _ftNotifs.forEach(function(n) { %>
            <div style="display:flex;align-items:flex-start;border-bottom:1px solid #f0f4f8;">
              <!-- Clickable area → goes to student report and marks as read -->
              <a href="/instructor/view-test-notification/<%= n.notif_id %>"
                 style="display:flex;align-items:flex-start;gap:12px;padding:12px 10px 12px 16px;flex:1;text-decoration:none;color:inherit;transition:background .15s;"
                 onmouseover="this.style.background='#f5f8fc'" onmouseout="this.style.background=''">
                <div class="notif-icon">📊</div>
                <div class="notif-body">
                  <div class="notif-name"><%= n.users ? n.users.name : '—' %></div>
                  <div class="notif-meta">
                    <%= _testLabels[n.test_type] || n.test_type %> ·
                    <%= n.test_period === 'pre' ? 'Pre-Test' : 'Post-Test' %>
                    <% if (n.rating) { %> · <strong><%= n.rating.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase()) %></strong><% } %>
                  </div>
                  <div class="notif-time"><%= new Date(n.created_at).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' }) %></div>
                </div>
              </a>
              <!-- Dismiss button -->
              <form method="POST" action="/instructor/dismiss-test-notification" style="margin:0;padding:10px 12px 0 0;flex-shrink:0;">
                <input type="hidden" name="notif_id" value="<%= n.notif_id %>">
                <button type="submit" title="Dismiss" style="background:none;border:none;cursor:pointer;color:#ccc;font-size:1rem;padding:2px 4px;line-height:1;" onmouseover="this.style.color='#e53935'" onmouseout="this.style.color='#ccc'">✕</button>
              </form>
            </div>
            <% }) %>
          <% } %>

          <!-- Health Appraisal Record Submissions -->
          <% if (_haNotifs.length > 0) { %>
            <div style="padding:6px 14px 4px;font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;color:#aaa;font-weight:700;background:#fafafa;border-bottom:1px solid #f0f4f8;">
              🏥 New Health Appraisal Records
            </div>
            <% _haNotifs.forEach(function(n) { %>
            <div style="display:flex;align-items:flex-start;border-bottom:1px solid #f0f4f8;">
              <a href="/instructor/view-health-appraisal/<%= n.notification_id %>"
                 style="display:flex;align-items:flex-start;gap:12px;padding:12px 10px 12px 16px;flex:1;text-decoration:none;color:inherit;transition:background .15s;"
                 onmouseover="this.style.background='#f5f8fc'" onmouseout="this.style.background=''">
                <div class="notif-icon">🏥</div>
                <div class="notif-body">
                  <div class="notif-name"><%= n.users ? n.users.name : '—' %></div>
                  <div class="notif-meta">Submitted Health Appraisal Record (PAR-Q)</div>
                  <div class="notif-time"><%= new Date(n.created_at).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' }) %></div>
                </div>
              </a>
              <!-- Dismiss button -->
              <form method="POST" action="/instructor/dismiss-health-appraisal-notification" style="margin:0;padding:10px 12px 0 0;flex-shrink:0;">
                <input type="hidden" name="notification_id" value="<%= n.notification_id %>">
                <button type="submit" title="Dismiss" style="background:none;border:none;cursor:pointer;color:#ccc;font-size:1rem;padding:2px 4px;line-height:1;" onmouseover="this.style.color='#e53935'" onmouseout="this.style.color='#ccc'">✕</button>
              </form>
            </div>
            <% }) %>
          <% } %>

          <!-- Registration requests -->
          <% if (_pendingRegistrations.length > 0) { %>
            <div style="padding:6px 14px 4px;font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;color:#aaa;font-weight:700;background:#fafafa;border-bottom:1px solid #f0f4f8;">
              New Registrations
            </div>
            <% _pendingRegistrations.forEach(function(s) { %>
            <button type="button" class="notif-item"
              data-user-id="<%= s.user_id %>"
              data-name="<%= (s.name || '').replace(/"/g, '&quot;') %>"
              data-student-id="<%= s.student_id || '' %>"
              data-email="<%= s.email %>"
              data-course="<%= (s.course || '—').replace(/"/g, '&quot;') %>"
              data-section="<%= (s.section || '—').replace(/"/g, '&quot;') %>"
              data-year-level="<%= s.year_level || '—' %>"
              data-pathfit-level="<%= s.pathfit_level %>"
              data-gender="<%= s.gender || '—' %>"
              data-age="<%= s.age || '—' %>"
              data-created-at="<%= new Date(s.created_at).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' }) %>"
              onclick="openStudentModal(this)">
              <div class="notif-icon">👤</div>
              <div class="notif-body">
                <div class="notif-name"><%= s.name %></div>
                <div class="notif-meta">Registered · awaiting approval</div>
                <div class="notif-time"><%= new Date(s.created_at).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' }) %></div>
              </div>
            </button>
            <% }) %>
          <% } %>

          <!-- Password reset requests -->
          <% if (_resets.length > 0) { %>
            <div style="padding:6px 14px 4px;font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;color:#aaa;font-weight:700;background:#fafafa;border-bottom:1px solid #f0f4f8;">
              Password Reset Requests
            </div>
            <% _resets.forEach(function(r) { %>
            <button type="button" class="notif-item"
              data-request-id="<%= r.request_id %>"
              data-name="<%= ((r.users && r.users.name) || '').replace(/"/g, '&quot;') %>"
              data-email="<%= (r.users && r.users.email) || '' %>"
              data-student-id="<%= (r.users && r.users.student_id) || '' %>"
              data-section="<%= ((r.users && r.users.section) || '—').replace(/"/g, '&quot;') %>"
              data-course="<%= ((r.users && r.users.course) || '—').replace(/"/g, '&quot;') %>"
              data-requested-at="<%= new Date(r.requested_at).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' }) %>"
              onclick="openResetModal(this)">
              <div class="notif-icon">🔑</div>
              <div class="notif-body">
                <div class="notif-name"><%= r.users.name %></div>
                <div class="notif-meta">Password reset · awaiting approval</div>
                <div class="notif-time"><%= new Date(r.requested_at).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' }) %></div>
              </div>
            </button>
            <% }) %>
          <% } %>

        </div>
      </div>

    <% } else { %>
      <a href="/student/dashboard">Dashboard</a>
      <a href="/student/fitness-tests">Fitness Tests</a>
      <a href="/student/lesson-plans">Modules</a>
      <a href="/student/report">My Report</a>
    <% } %>
    <a href="/logout">Logout</a>
  </nav>
  <% } %>
</header>

<!-- ── Modals: rendered outside <header> so position:fixed works correctly ── -->
<% if (user && user.role === 'instructor') { %>

<!-- Student Approval Modal -->
<div class="modal-overlay" id="studentModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-box">
    <div class="modal-header">
      <div>
        <div class="modal-title" id="modalTitle">New Student Registration</div>
        <div class="modal-sub">Review the details below and approve or reject this account.</div>
      </div>
      <button class="modal-close" onclick="closeStudentModal()" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <div class="modal-avatar" id="modalAvatar">👤</div>
      <div class="modal-name" id="modalName"></div>
      <div class="modal-email" id="modalEmail"></div>
      <div class="modal-grid">
        <div class="modal-field"><span class="modal-label">Student ID</span><span class="modal-val" id="modalStudentId"></span></div>
        <div class="modal-field"><span class="modal-label">Gender</span><span class="modal-val" id="modalGender"></span></div>
        <div class="modal-field"><span class="modal-label">Age</span><span class="modal-val" id="modalAge"></span></div>
        <div class="modal-field"><span class="modal-label">Course</span><span class="modal-val" id="modalCourse"></span></div>
        <div class="modal-field"><span class="modal-label">Section Code</span><span class="modal-val" id="modalSection"></span></div>
        <div class="modal-field"><span class="modal-label">Year Level</span><span class="modal-val" id="modalYear"></span></div>
        <div class="modal-field"><span class="modal-label">PATHFit Level</span><span class="modal-val" id="modalPathfit"></span></div>
        <div class="modal-field" style="grid-column:1/-1"><span class="modal-label">Registered</span><span class="modal-val" id="modalDate"></span></div>
      </div>
    </div>
    <div class="modal-footer">
      <form method="POST" action="/instructor/approve-student" style="display:contents;">
        <input type="hidden" name="user_id" id="modalUserId">
        <input type="hidden" name="action" value="approve">
        <button type="submit" class="btn modal-approve-btn">✓ Approve</button>
      </form>
      <form method="POST" action="/instructor/approve-student" style="display:contents;"
            onsubmit="return confirm('Reject and permanently delete this registration?')">
        <input type="hidden" name="user_id" id="modalUserIdReject">
        <input type="hidden" name="action" value="reject">
        <button type="submit" class="btn modal-reject-btn">✕ Reject</button>
      </form>
      <button type="button" class="btn modal-cancel-btn" onclick="closeStudentModal()">Cancel</button>
    </div>
  </div>
</div>

<!-- Password Reset Approval Modal -->
<div class="modal-overlay" id="resetModal" role="dialog" aria-modal="true" aria-labelledby="resetModalTitle">
  <div class="modal-box">
    <div class="modal-header">
      <div>
        <div class="modal-title" id="resetModalTitle">Password Reset Request</div>
        <div class="modal-sub">A student is requesting a password change. Approve to apply it immediately.</div>
      </div>
      <button class="modal-close" onclick="closeResetModal()" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <div class="modal-avatar" style="background:linear-gradient(135deg,#b71c1c,#e53935);">🔑</div>
      <div class="modal-name" id="resetModalName"></div>
      <div class="modal-email" id="resetModalEmail"></div>
      <div class="modal-grid">
        <div class="modal-field"><span class="modal-label">Student ID</span><span class="modal-val" id="resetModalStudentId"></span></div>
        <div class="modal-field"><span class="modal-label">Section Code</span><span class="modal-val" id="resetModalSection"></span></div>
        <div class="modal-field"><span class="modal-label">Course</span><span class="modal-val" id="resetModalCourse"></span></div>
        <div class="modal-field"><span class="modal-label">Requested</span><span class="modal-val" id="resetModalDate"></span></div>
      </div>
      <div style="margin-top:16px;padding:12px 14px;background:#fff8e1;border:1px solid #ffe082;border-radius:8px;font-size:.83rem;color:#7b5800;">
        ⚠️ Approving will immediately change this student's password to the one they submitted.
      </div>
    </div>
    <div class="modal-footer">
      <form method="POST" action="/instructor/reset-password" style="display:contents;">
        <input type="hidden" name="request_id" id="resetModalRequestId">
        <input type="hidden" name="action" value="approve">
        <button type="submit" class="btn modal-approve-btn">✓ Approve Reset</button>
      </form>
      <form method="POST" action="/instructor/reset-password" style="display:contents;">
        <input type="hidden" name="request_id" id="resetModalRequestIdDecline">
        <input type="hidden" name="action" value="decline">
        <button type="submit" class="btn modal-reject-btn">✕ Decline</button>
      </form>
      <button type="button" class="btn modal-cancel-btn" onclick="closeResetModal()">Cancel</button>
    </div>
  </div>
</div>

<% } %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // ── Notification bell toggle ──
    const btn      = document.getElementById('notifBtn');
    const dropdown = document.getElementById('notifDropdown');
    if (btn && dropdown) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        dropdown.classList.toggle('open');
      });
      document.addEventListener('click', function () {
        dropdown.classList.remove('open');
      });
      dropdown.addEventListener('click', function (e) {
        e.stopPropagation();
      });
    }

    // ── Close modals on backdrop click ──
    const studentOverlay = document.getElementById('studentModal');
    if (studentOverlay) {
      studentOverlay.addEventListener('click', function (e) {
        if (e.target === studentOverlay) closeStudentModal();
      });
    }
    const resetOverlay = document.getElementById('resetModal');
    if (resetOverlay) {
      resetOverlay.addEventListener('click', function (e) {
        if (e.target === resetOverlay) closeResetModal();
      });
    }

    // ── Close on Escape ──
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { closeStudentModal(); closeResetModal(); }
    });
  });

  // ── Student Approval Modal ──
  function openStudentModal(element) {
    const dd = document.getElementById('notifDropdown');
    if (dd) dd.classList.remove('open');

    const s = element.dataset;

    document.getElementById('modalName').textContent      = s.name || '—';
    document.getElementById('modalEmail').textContent     = s.email || '—';
    document.getElementById('modalStudentId').textContent = s.studentId || '—';
    document.getElementById('modalGender').textContent    = s.gender ? s.gender.charAt(0).toUpperCase() + s.gender.slice(1) : '—';
    document.getElementById('modalAge').textContent       = s.age || '—';
    document.getElementById('modalCourse').textContent    = s.course || '—';
    document.getElementById('modalSection').textContent   = s.section || '—';
    document.getElementById('modalYear').textContent      = s.yearLevel && s.yearLevel !== '—'
      ? s.yearLevel + (s.yearLevel==='1'?'st':s.yearLevel==='2'?'nd':s.yearLevel==='3'?'rd':'th') + ' Year'
      : '—';
    document.getElementById('modalPathfit').textContent   = 'PATHFit ' + (s.pathfitLevel || '—');
    document.getElementById('modalDate').textContent      = s.createdAt || '—';
    document.getElementById('modalUserId').value          = s.userId || '';
    document.getElementById('modalUserIdReject').value    = s.userId || '';

    const overlay = document.getElementById('studentModal');
    overlay.scrollTop = 0;
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeStudentModal() {
    document.getElementById('studentModal').classList.remove('open');
    document.body.style.overflow = '';
  }

  // ── Password Reset Modal ──
  function openResetModal(element) {
    const dd = document.getElementById('notifDropdown');
    if (dd) dd.classList.remove('open');

    const r = element.dataset;

    document.getElementById('resetModalName').textContent       = r.name || '—';
    document.getElementById('resetModalEmail').textContent      = r.email || '—';
    document.getElementById('resetModalStudentId').textContent  = r.studentId || '—';
    document.getElementById('resetModalSection').textContent    = r.section || '—';
    document.getElementById('resetModalCourse').textContent     = r.course || '—';
    document.getElementById('resetModalDate').textContent       = r.requestedAt || '—';
    document.getElementById('resetModalRequestId').value        = r.requestId || '';
    document.getElementById('resetModalRequestIdDecline').value = r.requestId || '';

    const overlay = document.getElementById('resetModal');
    overlay.scrollTop = 0;
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeResetModal() {
    document.getElementById('resetModal').classList.remove('open');
    document.body.style.overflow = '';
  }
</script>
