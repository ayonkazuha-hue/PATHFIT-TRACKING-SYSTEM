<%- include('partials/header', { title: 'Health Appraisal Record' }) %>
<style>
.har-container { max-width: 900px; margin: 30px auto; padding: 0 20px; }
.har-header { display:flex; align-items:center; justify-content:space-between; gap:20px; text-align:left; background: linear-gradient(135deg, #042C53, #185FA5); color: #fff; padding: 24px 20px; border-radius: 12px 12px 0 0; margin-bottom: 0; }
.har-header h1 { margin: 0 0 8px; font-size: 1.5rem; font-weight: 700; }
.har-header .subtitle { font-size: .88rem; opacity: .95; margin: 0; }
.har-form { background: #fff; border: 2px solid #e0e7ef; border-top: none; border-radius: 0 0 12px 12px; padding: 28px 32px; }
.har-section { margin-bottom: 28px; padding-bottom: 24px; border-bottom: 2px solid #f0f4f8; }
.har-section:last-child { border-bottom: none; }
.har-section-title { font-size: .78rem; text-transform: uppercase; letter-spacing: 1px; color: #185FA5; font-weight: 700; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #185FA5; }
.har-info-text { background: #f8f9fb; border-left: 4px solid #185FA5; padding: 14px 16px; margin-bottom: 20px; font-size: .85rem; line-height: 1.6; color: #333; }
.har-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px; }
.har-row.two-col { grid-template-columns: 1fr 1fr; }
.har-row.full { grid-template-columns: 1fr; }
.har-field label { display: block; font-size: .82rem; font-weight: 600; color: #042C53; margin-bottom: 6px; }
.har-field input[type="text"],
.har-field input[type="number"],
.har-field select { width: 100%; padding: 9px 12px; border: 1.5px solid #cdd5e0; border-radius: 7px; font-size: .9rem; box-sizing: border-box; }
.har-field input:focus,
.har-field select:focus { outline: none; border-color: #185FA5; box-shadow: 0 0 0 3px rgba(24,95,165,.1); }
.har-question { margin-bottom: 18px; }
.har-question-text { font-size: .88rem; font-weight: 600; color: #042C53; margin-bottom: 10px; }
.har-question-sub { font-size: .82rem; color: #666; font-style: italic; margin-top: 4px; }
.har-radio-group { display: flex; gap: 24px; margin-bottom: 8px; }
.har-radio-label { display: flex; align-items: center; gap: 8px; font-size: .88rem; cursor: pointer; }
.har-radio-label input[type="radio"] { width: 18px; height: 18px; cursor: pointer; }
.har-checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; padding-left: 20px; }
.har-checkbox-label { display: flex; align-items: center; gap: 8px; font-size: .84rem; cursor: pointer; }
.har-checkbox-label input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; }
.har-details { margin-top: 8px; }
.har-details textarea { width: 100%; padding: 9px 12px; border: 1.5px solid #cdd5e0; border-radius: 7px; font-size: .88rem; min-height: 60px; resize: vertical; box-sizing: border-box; }
.har-certify { background: #fff8e1; border: 2px solid #ffc107; border-radius: 8px; padding: 16px 18px; margin: 24px 0; }
.har-certify-text { font-size: .88rem; font-weight: 600; color: #7b5800; margin-bottom: 12px; }
.har-certify-check { display: flex; align-items: center; gap: 10px; }
.har-certify-check input[type="checkbox"] { width: 20px; height: 20px; cursor: pointer; }
.har-certify-check label { font-size: .9rem; font-weight: 600; color: #042C53; cursor: pointer; }
.har-submit { width: 100%; padding: 14px 24px; background: #185FA5; color: #fff; border: none; border-radius: 8px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: background .2s; }
.har-submit:hover { background: #0d4a7a; }
.har-submit:disabled { background: #ccc; cursor: not-allowed; }
.alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: .88rem; }
.alert-error { background: #ffebee; border: 1px solid #ef5350; color: #c62828; }
.alert-warn { background: #fff8e1; border: 1px solid #ffc107; color: #7b5800; }
</style>

<div class="har-container">
  <div class="har-header">
    <div style="flex:1;">
      <h1>🏥 Health Appraisal Record</h1>
      <p class="subtitle">(Physical Activity Readiness Questionnaire - PAR-Q)</p>
    </div>
    <img src="/images/nbsc_logo.png" alt="NBSC Logo" style="height:80px;width:auto;object-fit:contain;">
  </div>

  <div class="har-form">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="har-info-text">
      <strong>Welcome, <%= user.name %>!</strong><br>
      The Health Appraisal Record is designed to identify the medical and physical conditions of the participants. All information entered in this form will be dealt with confidentially. At the beginning of the course the learner/participant will undergo battery of tests, and the results will be evaluated and will be the basis for creating an individualized program. At the end of the course, the learner/participant will be re-tested to check improvements.
    </div>

    <div class="har-info-text">
      That signing this form is an acknowledgement that as participant of the tests and/or exercise, they are fully aware that they will be performing exercises and/or undergo tests, and that these tests and/or exercises can/may cause discomfort. that upon signing this form, they are fully aware about risks of their participation in the tests and/or exercises, and at the same timwe, they accept responisbility for their actions while performing the tests or the exercises.
    </div>

    <div class="har-info-text">
      that upon signing this form, they signify that they are fully aware about the benefits and the risks of the tests and/or the exercises, and at the same time, they can withraw or discontinue participating in both or either the tests or the exercises. that the information revealed in the form is revealed by the participant voluntarty, as indicated in the Health Appraisal Record and informed Consent.
    </div>

    <form method="POST" action="/health-screening" id="harForm">
      <!-- I. Personal Data -->
      <div class="har-section">
        <div class="har-section-title">I. Personal Data</div>
        <div class="har-row">
          <div class="har-field">
            <label>Name *</label>
            <input type="text" name="name" value="<%= user.name %>" readonly style="background:#f5f5f5;">
          </div>
          <div class="har-field">
            <label>Gender *</label>
            <select name="gender" required>
              <option value="">— Select —</option>
              <option value="Male" <%= user.gender === 'male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= user.gender === 'female' ? 'selected' : '' %>>Female</option>
            </select>
          </div>
          <div class="har-field">
            <label>Age *</label>
            <input type="number" name="age" min="15" max="100" required placeholder="e.g., 20">
          </div>
        </div>
        <div class="har-row full">
          <div class="har-field">
            <label>2x2 Photo Upload</label>
            <input type="file" id="photoFile" accept="image/png,image/jpeg" style="padding:9px 12px;" />
            <input type="hidden" name="photo_url" id="photo_url">
            <div id="photoPreview" style="margin-top:10px;"></div>
            <small style="color:#666; display:block; margin-top:6px;">Upload a 2x2 photo in JPG or PNG format. Max 5MB.</small>
            <div id="photoUploadStatus" style="margin-top:8px;color:#555;font-size:.88rem;"></div>
          </div>
        </div>
      </div>

      <!-- II. Physical Check-up Result -->
      <div class="har-section">
        <div class="har-section-title">II. Physical Check-up Result</div>
        <div class="har-row">
          <div class="har-field">
            <label>Height (kg)</label>
            <input type="number" step="0.01" name="height_kg" placeholder="e.g., 65.5">
          </div>
          <div class="har-field">
            <label>Weight (cm)</label>
            <input type="number" step="0.01" name="weight_cm" placeholder="e.g., 170.5">
          </div>
          <div class="har-field">
            <label>Resting Pulse Rate</label>
            <input type="number" name="resting_pulse_rate" placeholder="e.g., 72">
          </div>
        </div>
        <div class="har-row">
          <div class="har-field">
            <label>Waistline (inches)</label>
            <input type="number" step="0.01" name="waistline_inches" placeholder="e.g., 28.5">
          </div>
          <div class="har-field">
            <label>Ideal Weight</label>
            <input type="text" name="ideal_weight" placeholder="e.g., Normal">
          </div>
          <div class="har-field">
            <label>BMI Value</label>
            <input type="number" step="0.1" name="bmi_value" id="bmi_value" placeholder="e.g., 22.5">
          </div>
          <div class="har-field">
            <label>BMI Classification</label>
            <input type="text" name="bmi_classification" id="bmi_classification" placeholder="e.g., Normal" readonly>
          </div>
        </div>
      </div>

      <!-- III. Medical-related Questionnaire -->
      <div class="har-section">
        <div class="har-section-title">III. Medical-related Questionnaire</div>
        <p style="font-size:.86rem;color:#555;margin-bottom:20px;font-style:italic;">Please answer by checking the appropriate column, as honestly as possible:</p>

        <!-- Q1 -->
        <div class="har-question">
          <div class="har-question-text">1. Have you had any hospitalization/surgery for the last 5 years?</div>
          <div class="har-radio-group">
            <label class="har-radio-label"><input type="radio" name="q1_hospitalization" value="yes" onchange="toggleDetails('q1')"> Yes</label>
            <label class="har-radio-label"><input type="radio" name="q1_hospitalization" value="no" onchange="toggleDetails('q1')" checked> No</label>
          </div>
          <div class="har-details" id="q1_details" style="display:none;">
            <div class="har-question-sub">If yes, please indicate the nature of hospitalization/surgery:</div>
            <textarea name="q1_details" placeholder="Describe the nature of hospitalization/surgery..."></textarea>
          </div>
        </div>

        <!-- Q2 -->
        <div class="har-question">
          <div class="har-question-text">2. Have you sustained or had major injury for the last 5 years?</div>
          <div class="har-radio-group">
            <label class="har-radio-label"><input type="radio" name="q2_injury" value="yes" onchange="toggleDetails('q2')"> Yes</label>
            <label class="har-radio-label"><input type="radio" name="q2_injury" value="no" onchange="toggleDetails('q2')" checked> No</label>
          </div>
          <div class="har-details" id="q2_details" style="display:none;">
            <div class="har-question-sub">If yes, please describe the nature of the injury:</div>
            <textarea name="q2_details" placeholder="Describe the nature of the injury..."></textarea>
          </div>
        </div>

        <!-- Q3 -->
        <div class="har-question">
          <div class="har-question-text">3. Have you experienced or have been diagnosed with, any or all of the following:</div>
          <div class="har-radio-group">
            <label class="har-radio-label"><input type="radio" name="q3_diagnosed" value="yes" onchange="toggleDetails('q3')"> Yes</label>
            <label class="har-radio-label"><input type="radio" name="q3_diagnosed" value="no" onchange="toggleDetails('q3')" checked> No</label>
          </div>
          <div class="har-details" id="q3_details" style="display:none;">
            <div class="har-checkbox-grid">
              <label class="har-checkbox-label"><input type="checkbox" name="q3_conditions" value="3.1 Chest pain"> 3.1 Chest pain</label>
              <label class="har-checkbox-label"><input type="checkbox" name="q3_conditions" value="3.2 Difficulty breathing"> 3.2 Difficulty breathing</label>
              <label class="har-checkbox-label"><input type="checkbox" name="q3_conditions" value="3.3 Dizziness or fainting spell"> 3.3 Dizziness or fainting spell</label>
              <label class="har-checkbox-label"><input type="checkbox" name="q3_conditions" value="3.4 Hypertension (High Blood Pressure)"> 3.4 Hypertension (High Blood Pressure)</label>
              <label class="har-checkbox-label"><input type="checkbox" name="q3_conditions" value="3.5 Anemia"> 3.5 Anemia</label>
              <label class="har-checkbox-label"><input type="checkbox" name="q3_conditions" value="3.6 Kidney problem"> 3.6 Kidney problem</label>
              <label class="har-checkbox-label"><input type="checkbox" name="q3_conditions" value="3.7 Arthritis"> 3.7 Arthritis</label>
              <label class="har-checkbox-label"><input type="checkbox" name="q3_conditions" value="3.8 Gout"> 3.8 Gout</label>
              <label class="har-checkbox-label"><input type="checkbox" name="q3_conditions" value="3.9 Dislocation"> 3.9 Dislocation</label>
              <label class="har-checkbox-label"><input type="checkbox" name="q3_conditions" value="3.10 Fracture"> 3.10 Fracture</label>
            </div>
          </div>
        </div>

        <!-- Q4 -->
        <div class="har-question">
          <div class="har-question-text">4. Have you experienced lower back pain?</div>
          <div class="har-radio-group">
            <label class="har-radio-label"><input type="radio" name="q4_lower_back_pain" value="yes"> Yes</label>
            <label class="har-radio-label"><input type="radio" name="q4_lower_back_pain" value="no" checked> No</label>
          </div>
        </div>

        <!-- Q5 -->
        <div class="har-question">
          <div class="har-question-text">5. Do you have ailments which restrict movement or physical activity?</div>
          <div class="har-radio-group">
            <label class="har-radio-label"><input type="radio" name="q5_movement_restriction" value="yes"> Yes</label>
            <label class="har-radio-label"><input type="radio" name="q5_movement_restriction" value="no" checked> No</label>
          </div>
        </div>

        <!-- Q6 -->
        <div class="har-question">
          <div class="har-question-text">6. Are you under medical treatment?</div>
          <div class="har-radio-group">
            <label class="har-radio-label"><input type="radio" name="q6_medical_treatment" value="yes"> Yes</label>
            <label class="har-radio-label"><input type="radio" name="q6_medical_treatment" value="no" checked> No</label>
          </div>
        </div>

        <!-- Q7 -->
        <div class="har-question">
          <div class="har-question-text">7. Do you engage in regular exercise (at least 3 times a week)?</div>
          <div class="har-radio-group">
            <label class="har-radio-label"><input type="radio" name="q7_regular_exercise" value="yes" onchange="toggleDetails('q7')"> Yes</label>
            <label class="har-radio-label"><input type="radio" name="q7_regular_exercise" value="no" onchange="toggleDetails('q7')" checked> No</label>
          </div>
          <div class="har-details" id="q7_details" style="display:none;">
            <div class="har-question-sub">If yes, how long do you exercise (30 minutes, 1 hour, etc.)?</div>
            <textarea name="q7_details" placeholder="e.g., 1 hour, 3 times a week"></textarea>
          </div>
        </div>

        <!-- Q8 -->
        <div class="har-question">
          <div class="har-question-text">8. Do you smoke?</div>
          <div class="har-radio-group">
            <label class="har-radio-label"><input type="radio" name="q8_smoke" value="yes" onchange="toggleDetails('q8')"> Yes</label>
            <label class="har-radio-label"><input type="radio" name="q8_smoke" value="no" onchange="toggleDetails('q8')" checked> No</label>
          </div>
          <div class="har-details" id="q8_details" style="display:none;">
            <div class="har-question-sub">If yes, how many sticks a day?</div>
            <textarea name="q8_details" placeholder="e.g., 5 sticks per day"></textarea>
          </div>
        </div>

        <!-- Q9 -->
        <div class="har-question">
          <div class="har-question-text">9. Do you drink alcoholic beverages?</div>
          <div class="har-radio-group">
            <label class="har-radio-label"><input type="radio" name="q9_alcohol" value="yes" onchange="toggleDetails('q9')"> Yes</label>
            <label class="har-radio-label"><input type="radio" name="q9_alcohol" value="no" onchange="toggleDetails('q9')" checked> No</label>
          </div>
          <div class="har-details" id="q9_details" style="display:none;">
            <div class="har-question-sub">If yes, how often?</div>
            <textarea name="q9_details" placeholder="e.g., Once a week, socially"></textarea>
          </div>
        </div>
      </div>

      <!-- Certification -->
      <div class="har-certify">
        <div class="har-certify-text">I certify as to the correctness of the answers to the above questions.</div>
        <div class="har-certify-check">
          <input type="checkbox" name="certify_correctness" id="certifyCheck" required>
          <label for="certifyCheck">Yes, I certify that all information provided is accurate and complete. *</label>
        </div>
      </div>

      <button type="submit" class="har-submit">📋 Submit Health Appraisal Record</button>
    </form>
  </div>
</div>

<script>
function toggleDetails(questionId) {
  const yesRadio = document.querySelector(`input[name="q${questionId}_${questionId === '1' ? 'hospitalization' : questionId === '2' ? 'injury' : 'diagnosed'}"][value="yes"]`);
  const detailsDiv = document.getElementById(`q${questionId}_details`);
  
  if (yesRadio && yesRadio.checked) {
    detailsDiv.style.display = 'block';
  } else {
    detailsDiv.style.display = 'none';
  }
}

const photoFileInput = document.getElementById('photoFile');
const photoPreview = document.getElementById('photoPreview');
const photoStatus = document.getElementById('photoUploadStatus');
const photoUrlInput = document.getElementById('photo_url');
const harForm = document.getElementById('harForm');
let photoUploadInProgress = false;
let pendingUploadPromise = null;

function updatePhotoStatus(message) {
  if (photoStatus) photoStatus.textContent = message;
}

async function uploadHarPhoto(file) {
  if (!file) throw new Error('No file selected.');
  if (!['image/jpeg', 'image/png'].includes(file.type)) throw new Error('Please upload a JPG or PNG photo.');
  if (file.size > 5 * 1024 * 1024) throw new Error('Photo must be 5MB or less.');

  photoUploadInProgress = true;
  updatePhotoStatus('Uploading photo...');

  const response = await fetch('/health-screening/get-upload-url', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ filename: file.name })
  });

  if (!response.ok) {
    const errorText = await response.text();
    throw new Error(errorText || 'Unable to get upload URL');
  }

  const { signedUrl, path } = await response.json();
  const uploadResponse = await fetch(signedUrl, {
    method: 'PUT',
    body: file,
    headers: { 'Content-Type': file.type }
  });

  if (!uploadResponse.ok) {
    throw new Error('Photo upload failed.');
  }

  photoUrlInput.value = path;
  photoUploadInProgress = false;
  updatePhotoStatus('Photo uploaded successfully.');
  return path;
}

photoFileInput?.addEventListener('change', function() {
  const file = this.files[0];
  photoPreview.innerHTML = '';
  updatePhotoStatus('');
  photoUrlInput.value = '';

  if (!file) return;
  if (!file.type.startsWith('image/')) {
    updatePhotoStatus('Please select a JPG or PNG image.');
    this.value = '';
    return;
  }
  if (file.size > 5 * 1024 * 1024) {
    updatePhotoStatus('Photo must be 5MB or less.');
    this.value = '';
    return;
  }

  const img = document.createElement('img');
  img.src = URL.createObjectURL(file);
  img.style.maxHeight = '120px';
  img.style.borderRadius = '8px';
  img.style.border = '1px solid #ccc';
  img.onload = () => URL.revokeObjectURL(img.src);
  photoPreview.appendChild(img);

  pendingUploadPromise = uploadHarPhoto(file).catch(err => {
    console.error('Photo upload error:', err);
    updatePhotoStatus('Upload failed: ' + (err.message || 'Please try again.'));
    photoUploadInProgress = false;
  });
});

harForm?.addEventListener('submit', async function(e) {
  const certifyCheck = document.getElementById('certifyCheck');
  if (!certifyCheck.checked) {
    e.preventDefault();
    alert('Please certify that all information provided is accurate and complete.');
    certifyCheck.focus();
    return;
  }

  const file = photoFileInput?.files?.[0];
  if (!file) return;
  if (photoUploadInProgress) {
    e.preventDefault();
    updatePhotoStatus('Please wait until the photo upload is complete.');
    return;
  }
  if (!photoUrlInput.value) {
    e.preventDefault();
    try {
      await (pendingUploadPromise || uploadHarPhoto(file));
      harForm.submit();
    } catch (err) {
      console.error('Photo upload error during submit:', err);
      updatePhotoStatus('Upload failed: ' + (err.message || 'Please try again.'));
    }
  }
});
</script>

<script>
// BMI classification helper
function classifyBMIValue(bmi) {
  if (bmi === null || bmi === undefined || bmi === '') return '';
  const v = parseFloat(bmi);
  if (Number.isNaN(v)) return '';
  if (v < 18.5) return 'Underweight';
  if (v >= 18.5 && v <= 24.9) return 'Normal';
  if (v >= 25 && v <= 29.9) return 'Overweight';
  if (v >= 30 && v <= 34.9) return 'Obese';
  if (v >= 35 && v <= 39.9) return 'Severely Obese';
  return 'Morbidly Obese';
}

const bmiValueInput = document.getElementById('bmi_value');
const bmiClassInput = document.getElementById('bmi_classification');
if (bmiValueInput && bmiClassInput) {
  bmiValueInput.addEventListener('input', function() {
    const val = this.value;
    const cls = classifyBMIValue(val);
    bmiClassInput.value = cls;
  });
  // populate on load if value exists
  if (bmiValueInput.value) {
    bmiClassInput.value = classifyBMIValue(bmiValueInput.value);
  }
}
</script>

<%- include('partials/footer') %>
