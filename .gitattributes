# Normalize line endings
* text=auto
*.js   text eol=lf
*.ejs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.txt  text eol=lf

# Binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.docx binary
*.pdf  binary
*.xlsx binary
